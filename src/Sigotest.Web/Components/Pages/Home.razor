@page "/"

@* Landing accesible a TODO usuario autenticado (solo FallbackPolicy, sin rol): es el
   destino del logo y de la raíz, así nadie aterriza en un módulo que su rol no ve
   (antes "/" era Calcular, solo Certificaciones). Muestra los módulos habilitados.
   Estilo portado del Home de SAF (tiles en grid con acento del tema). *@

<PageTitle>Inicio</PageTitle>

<section class="sigo-home">
    <div class="sigo-home__header">
        <span class="sigo-home__eyebrow">SIGO</span>
        <h1>Sistema Integral de Gestión de Obras</h1>
        <p>@Saludo()</p>
    </div>

    @if (cargado && modulos.Count == 0)
    {
        @* Recién registrado, sin roles: mismo mensaje que /sin-acceso. *@
        <div class="sigo-home__empty">
            Tu usuario ya quedó registrado en el sistema, pero todavía no tiene roles
            asignados. Pedile a un administrador que te habilite y después recargá la página (F5).
        </div>
    }
    else
    {
        <div class="sigo-home__grid">
            @foreach (var m in modulos)
            {
                @* Ancla real, no un div con @onclick: el router de Blazor la intercepta
                   igual (navegación sin recarga) y además queda accesible por teclado,
                   anunciada como link y abrible en pestaña nueva. *@
                <a class="sigo-home__tile" href="@m.Ruta">
                    <span class="rzi">@m.Icono</span>
                    <strong>@m.Titulo</strong>
                    <small>@m.Descripcion</small>
                </a>
            }
        </div>
    }
</section>

<style>
    /* Superficies adaptadas al tema, como en SAF: RadzenLayout expone .rz-material
       (claro) y .rz-material-dark (oscuro) en el DOM y sirven de gancho. */
    .rz-layout.rz-material-dark {
        --sigo-surface-border: rgba(255, 255, 255, .12);
        --sigo-surface-bg: rgba(255, 255, 255, .04);
    }

    .rz-layout.rz-material {
        --sigo-surface-border: rgba(0, 0, 0, .14);
        --sigo-surface-bg: rgba(0, 0, 0, .03);
    }

    .sigo-home {
        max-width: 1120px;
        padding: 2rem 1rem;
    }

    .sigo-home__header {
        margin-bottom: 1.5rem;
    }

    .sigo-home__eyebrow {
        color: var(--rz-primary);
        font-size: .85rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .sigo-home h1 {
        margin: .35rem 0 .5rem;
    }

    .sigo-home__grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }

    .sigo-home__tile {
        display: grid;
        gap: .45rem;
        padding: 1rem;
        min-height: 140px;
        color: inherit;
        text-decoration: none;
        border: 1px solid var(--sigo-surface-border, rgba(255, 255, 255, .12));
        border-radius: 6px;
        background: var(--sigo-surface-bg, rgba(255, 255, 255, .04));
    }

    .sigo-home__tile:hover {
        border-color: var(--rz-primary);
    }

    .sigo-home__tile .rzi {
        font-size: 1.75rem;
        color: var(--rz-primary);
    }

    .sigo-home__tile small,
    .sigo-home__empty {
        color: var(--rz-text-secondary-color);
    }

    .sigo-home__empty {
        padding: 1rem;
        border: 1px solid var(--sigo-surface-border, rgba(255, 255, 255, .12));
        border-radius: 6px;
        background: var(--sigo-surface-bg, rgba(255, 255, 255, .04));
    }
</style>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private record Modulo(string Titulo, string Descripcion, string Icono, string Ruta);

    private readonly List<Modulo> modulos = [];
    private string? nombre;
    private bool cargado;

    // Sin nombre resuelto o sin módulos, la consigna genérica: anunciar "módulos
    // habilitados" contradiría el aviso de usuario sin roles que se muestra abajo.
    private string Saludo() =>
        nombre is null || modulos.Count == 0
            ? "Seleccioná un módulo para comenzar."
            : $"Hola, {nombre}. Seleccioná un módulo habilitado para comenzar.";

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;
        var user = (await AuthState).User;
        nombre = user.Identity?.Name is { } wu ? CuentaWindows.SinDominio(wu) : null;

        // Mismo criterio que el menú lateral de MainLayout: un módulo por rol.
        if (Roles.TieneAlguno(user.IsInRole, Roles.Certificaciones))
        {
            modulos.Add(new("Obras", "Catálogo de obras, certificados y estructuras de costos", "apartment", "obras"));
            modulos.Add(new("Calcular Redeterminación", "Cálculo de variación por tabla de ponderación", "calculate", "redeterminacion/calcular"));
            modulos.Add(new("Historial de Redeterminaciones", "Disparos de redeterminación guardados", "history", "redeterminacion/historial"));
            modulos.Add(new("Índices INDEC", "Catálogo de índices y carga de publicaciones", "trending_up", "indices"));
        }
        if (Roles.TieneAlguno(user.IsInRole, Roles.Planificacion))
            modulos.Add(new("Planificación", "Curvas de inversión por obra y circuito de aprobación", "event_note", "planificacion"));
        if (user.IsInRole(Roles.Admin))
            modulos.Add(new("Usuarios", "Alta de usuarios y asignación de roles", "group", "usuarios"));

        cargado = true;
    }
}
