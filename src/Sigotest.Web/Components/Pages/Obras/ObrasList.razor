@page "/obras"
@attribute [Authorize(Roles = Roles.Certificaciones)]
@inject ObraService ObraService
@inject NavigationManager Nav
@inject DialogService DialogService
@inject NotificationService Notifications
@inject EstadoGrillas Grillas
@inject RetornoObra Retorno

<PageTitle>Obras</PageTitle>

<CabeceraPagina Titulo="Obras" Estilo="TextStyle.H4">
    <Acciones>
        @if (obras is { Count: > 0 })
        {
            <FiltrosGrilla Vista="@vista" Placeholder="Buscar licitación, obra o contratista…" />
        }
        @* Primary: el alta es la acción principal del listado (Success queda para
           transiciones que consolidan estado — regla de color de la app). *@
        <RadzenButton Text="Nueva Obra" Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => Nav.NavigateTo("obras/nueva"))" />
    </Acciones>
</CabeceraPagina>

@if (obras is null)
{
    <EstadoCargando Texto="Cargando obras…" />
}
else if (obras.Count == 0)
{
    <EstadoVacio Icono="apartment" Titulo="No hay obras cargadas"
                 Descripcion="Las obras agrupan estructuras de costos, certificados y redeterminaciones. Creá la primera para empezar.">
        <Accion>
            <RadzenButton Text="Nueva Obra" Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => Nav.NavigateTo("obras/nueva"))" />
        </Accion>
    </EstadoVacio>
}
else
{
    <GrillaListado Vista="@vista">
        <RadzenDataGridColumn TItem="ObraVM" Property="NumeroLicitacion" Title="Licitación" Width="140px" />
        @* Todas las columnas con Width (convenciones-ui): con table-layout fixed una columna
           sin ancho recibe solo el sobrante y en una notebook con zoom quedaba en «…». *@
        <RadzenDataGridColumn TItem="ObraVM" Property="Nombre" Title="Nombre" Width="240px" />
        <RadzenDataGridColumn TItem="ObraVM" Property="Contratista" Title="Contratista" Width="200px" />
        @* Fechas: el título parte en dos líneas («Acta / Inicio») en vez de
           recortarse, y «Plazo Vencido» entra entero en los 150px de Estado. *@
        <RadzenDataGridColumn TItem="ObraVM" Property="FechaActaInicio" Title="Acta Inicio" Width="@AnchoColumna.Fecha"
                              FormatString="{0:dd/MM/yyyy}" TextAlign="TextAlign.Center" />
        <RadzenDataGridColumn TItem="ObraVM" Property="FechaFinalContrato" Title="Fin Contrato" Width="@AnchoColumna.Fecha"
                              FormatString="{0:dd/MM/yyyy}" TextAlign="TextAlign.Center" />
        @* Estado en texto, sin badge (convenciones-ui, «Celdas en texto»). *@
        <RadzenDataGridColumn TItem="ObraVM" Property="Estado" Title="Estado" Width="@AnchoColumna.Estado" Sortable="false" />
        @* Accesos a las secciones de la obra, en el orden de su ficha (convenciones-ui, «Íconos de
           las filas»). Reemplazan la columna «Tablas», que solo contaba las de ponderación. Un solo
           ícono de ir (la columna dice a qué sección), Primary como Editar; el «Volver» de la
           sección trae de nuevo acá (RetornoObra). *@
        <RadzenDataGridColumn TItem="ObraVM" Title="Estructuras" Width="120px" Sortable="false" Filterable="false"
                              TextAlign="TextAlign.Center">
            <Template Context="obra">
                <RadzenButton Icon="arrow_forward" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                              Variant="Variant.Text" title="Estructuras de costos"
                              Click="@(() => IrASeccion(obra, "estructuras"))" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ObraVM" Title="Certificados" Width="120px" Sortable="false" Filterable="false"
                              TextAlign="TextAlign.Center">
            <Template Context="obra">
                <RadzenButton Icon="arrow_forward" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                              Variant="Variant.Text" title="Certificados de avance"
                              Click="@(() => IrASeccion(obra, "certificados"))" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ObraVM" Title="Ponderación" Width="120px" Sortable="false" Filterable="false"
                              TextAlign="TextAlign.Center">
            <Template Context="obra">
                <RadzenButton Icon="arrow_forward" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                              Variant="Variant.Text" title="Tabla de ponderación"
                              Click="@(() => IrASeccion(obra, "ponderacion"))" />
            </Template>
        </RadzenDataGridColumn>
        @* 3 íconos (tenía 210px y le sobraban ~86). *@
        <RadzenDataGridColumn TItem="ObraVM" Title="" Width="@AnchoColumna.Acciones(3)" Sortable="false" Filterable="false"
                              TextAlign="TextAlign.Center">
            <Template Context="obra">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                    <RadzenButton Icon="visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info"
                                  Variant="Variant.Text" title="Ver"
                                  Click="@(() => Nav.NavigateTo($"obras/{obra.Id}"))" />
                    <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                  Variant="Variant.Text" title="Editar"
                                  Click="@(() => Nav.NavigateTo($"obras/{obra.Id}/editar"))" />
                    <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                  Variant="Variant.Text" title="Eliminar" Disabled="@procesando"
                                  Click="@(() => EliminarAsync(obra))" />
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
    </GrillaListado>
}

@code {
    private List<ObraVM>? obras;
    private VistaGrilla<ObraVM> vista = null!;
    private bool procesando;

    protected override async Task OnInitializedAsync()
    {
        vista = new(Grillas.De("obras"), o => [o.NumeroLicitacion, o.Nombre, o.Contratista]);
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        obras = await ObraService.ListarAsync();
        vista.Cargar(obras);
    }

    /// <summary>Abre una sección de la obra; su «Volver» trae de nuevo al listado (RetornoObra).</summary>
    private void IrASeccion(ObraVM obra, string seccion)
    {
        Retorno.DesdeListado(obra.Id);
        Nav.NavigateTo($"obras/{obra.Id}/{seccion}");
    }

    private async Task EliminarAsync(ObraVM obra)
    {
        if (procesando) return;
        // El flag antes del Confirm: un doble click no debe apilar dos diálogos.
        procesando = true;
        try
        {
            // El servicio chequea dependencias (mensaje específico antes de las FK
            // Restrict) y lleva el RowVersion de la grilla al DELETE.
            await UiAcciones.ConfirmarEliminarYRecargarAsync(DialogService, Notifications,
                $"¿Eliminar la obra \"{obra.Nombre}\"?",
                () => ObraService.EliminarAsync(obra.Id, obra.RowVersion),
                "Obra eliminada", obra.Nombre,
                "Ya eliminada", $"La obra \"{obra.Nombre}\" ya había sido eliminada por otro usuario.",
                CargarAsync);
        }
        finally { procesando = false; }
    }
}
