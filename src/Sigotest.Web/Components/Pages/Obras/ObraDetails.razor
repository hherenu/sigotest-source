@page "/obras/{Id:int}"
@attribute [Authorize(Roles = Roles.Certificaciones)]
@inject ObraService ObraService
@inject NavigationManager Nav
@inject DialogService DialogService
@inject NotificationService Notifications

<PageTitle>@(obra?.Nombre ?? "Obra")</PageTitle>

@if (noEncontrada)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
        No se encontró la obra solicitada.
    </RadzenAlert>
}
else if (obra is null)
{
    <EstadoCargando Texto="Cargando obra…" />
}
else
{
    <CabeceraPagina Titulo="@obra.Nombre" Estilo="TextStyle.H4" Clase="rz-mb-4">
        <Acciones>
            @* Sin el botón a Estructuras: duplicaba el "Ver / Gestionar" de la sección
               homónima de abajo y era el tercer botón verde de la cabecera. *@
            <RadzenButton Text="Editar" Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat"
                          Click="@(() => Nav.NavigateTo($"obras/{obra.Id}/editar"))" />
            <RadzenButton Text="Volver a Obras" Icon="arrow_back" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                          Click="@(() => Nav.NavigateTo("obras"))" />
        </Acciones>
    </CabeceraPagina>

    <RadzenRow Gap="1rem" RowGap="1rem">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenCard Variant="Variant.Outlined" style="height:100%">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Datos del Expediente</RadzenText>
                @Dato("Licitación", obra.NumeroLicitacion)
                @Dato("Antecedentes", obra.Antecedentes)
                @Dato("Contratista", obra.Contratista)
                @Dato("PUByC", obra.PUByC)
                @Dato("Presupuesto oficial", Importes(obra.PresupuestoOficial, obra.PresupuestoOficialUSD, obra.PresupuestoOficialEUR))
                @Dato("Presupuesto adjudicado", Importes(obra.PresupuestoAdjudicado, obra.PresupuestoAdjudicadoUSD, obra.PresupuestoAdjudicadoEUR))
                @Dato("Director de Obra", obra.DirectorNombre)
                @Dato("IF Designación", obra.IFDesignacion)
                <RadzenRow class="rz-mt-1">
                    <RadzenColumn Size="5">
                        <RadzenText TextStyle="TextStyle.Body2" class="app-muted rz-mb-0">Estado</RadzenText>
                    </RadzenColumn>
                    <RadzenColumn Size="7">
                        <RadzenBadge Text="@obra.Estado" IsPill="true"
                                     BadgeStyle="@EstadoUi.BadgeObra(obra.Estado)" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="6">
            <RadzenCard Variant="Variant.Outlined" style="height:100%">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Fechas</RadzenText>
                @Dato("Fecha Oferta", obra.FechaOferta?.ToString("dd/MM/yyyy"))
                @Dato("Oferta Final (IF)", obra.OfertaFinal)
                @Dato("Fecha Adjudicación", obra.FechaAdjudicacion?.ToString("dd/MM/yyyy"))
                @Dato("IF Adjudicación", obra.IFAdjudicacion)
                @Dato("Fecha Contrato", obra.FechaContrato?.ToString("dd/MM/yyyy"))
                @Dato("IF Contrato", obra.IFContrato)
                @Dato("Fecha Acta Inicio", obra.FechaActaInicio?.ToString("dd/MM/yyyy"))
                @Dato("IF Acta Inicio", obra.IFActaInicio)
                @Dato("Plazo de Obra", obra.PlazoObra)
                <RadzenRow class="rz-mt-1">
                    <RadzenColumn Size="5">
                        <RadzenText TextStyle="TextStyle.Body2" class="app-muted rz-mb-0">Fecha Final Contrato</RadzenText>
                    </RadzenColumn>
                    <RadzenColumn Size="7">
                        @* Rojo SOLO con el plazo vencido (misma regla que el badge de estado):
                           antes estaba siempre en rojo, también con años por delante, y el
                           rojo permanente desensibiliza el color de peligro. *@
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0"
                                    style="@(obra.Estado?.Contains("Vencido") == true ? "font-weight:600;color:var(--rz-danger)" : "font-weight:600")">
                            @obra.FechaFinalContrato?.ToString("dd/MM/yyyy")
                            @if (obra.Prorrogas.Count > 0)
                            {
                                <span class="app-muted" style="font-weight:400"> (con @obra.Prorrogas.Count prórroga@(obra.Prorrogas.Count == 1 ? "" : "s"))</span>
                            }
                        </RadzenText>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>
        </RadzenColumn>

        @* ── Prórrogas de plazo ── *@
        <RadzenColumn Size="12">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                             AlignItems="AlignItems.Center" class="rz-mb-2">
                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">
                        Prórrogas de plazo
                        <RadzenBadge Text="@obra.Prorrogas.Count.ToString()" BadgeStyle="BadgeStyle.Secondary" class="rz-ml-2" />
                    </RadzenText>
                    @* Con la regla de negocio en el clic (sin fecha de fin el servicio rechaza y
                       se notifica el motivo), no en un Disabled invisible por teclado. *@
                    <RadzenButton Text="Agregar prórroga" Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                  Disabled="@procesando" Click="@AgregarProrrogaAsync" />
                </RadzenStack>
                @if (obra.Prorrogas.Count == 0)
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="app-muted rz-mb-0">
                        Sin prórrogas: el fin de contrato vigente es el original.
                    </RadzenText>
                }
                else
                {
                    <RadzenDataGrid Data="@obra.Prorrogas" TItem="ProrrogaObraVM" Density="Density.Compact">
                        <Columns>
                            <RadzenDataGridColumn TItem="ProrrogaObraVM" Property="Numero" Title="N°" Width="60px" TextAlign="TextAlign.Center" />
                            <RadzenDataGridColumn TItem="ProrrogaObraVM" Property="FechaFinAnterior" Title="Fin anterior" Width="120px" FormatString="{0:dd/MM/yyyy}" />
                            <RadzenDataGridColumn TItem="ProrrogaObraVM" Property="FechaFinNueva" Title="Nuevo fin" Width="120px" FormatString="{0:dd/MM/yyyy}" />
                            <RadzenDataGridColumn TItem="ProrrogaObraVM" Property="FechaActo" Title="Fecha del acto" Width="130px" FormatString="{0:dd/MM/yyyy}" />
                            <RadzenDataGridColumn TItem="ProrrogaObraVM" Property="IFActo" Title="IF" Width="180px" />
                            <RadzenDataGridColumn TItem="ProrrogaObraVM" Property="Observaciones" Title="Observaciones" />
                            <RadzenDataGridColumn TItem="ProrrogaObraVM" Title="" Width="70px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                                <Template Context="p">
                                    @* Ícono solo, como las filas del listado de obras. Habilitado en todas: si
                                       no es la última, el servicio rechaza y el clic notifica el motivo
                                       (convención: regla de negocio ≠ Disabled). *@
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center">
                                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                                      Disabled="@procesando" title="Eliminar (solo la última prórroga)"
                                                      aria-label="@($"Eliminar prórroga N°{p.Numero}")"
                                                      Click="@(() => EliminarProrrogaAsync(p))" />
                                    </RadzenStack>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            </RadzenCard>
        </RadzenColumn>

        @* ── Estructuras de Costos ── *@
        <RadzenColumn Size="12">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                             AlignItems="AlignItems.Center" class="rz-mb-2">
                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">
                        Estructuras de Costos
                        <RadzenBadge Text="@obra.EstructurasCostos.Count.ToString()" BadgeStyle="BadgeStyle.Secondary" class="rz-ml-2" />
                    </RadzenText>
                    @* Navegación de sección: Light/Flat (el verde quedaba con el mismo peso
                       que las acciones reales y la página tenía 5 botones verdes). *@
                    <RadzenButton Text="Ver / Gestionar" Icon="account_tree" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                  Variant="Variant.Flat" Click="@(() => Nav.NavigateTo($"obras/{obra.Id}/estructuras"))" />
                </RadzenStack>
                @if (!obra.EstructurasCostos.Any())
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="app-muted rz-mb-0">Sin estructuras cargadas.</RadzenText>
                }
                else
                {
                    <ul class="rz-mb-0" style="padding-left:1.1rem;">
                        @foreach (var est in obra.EstructurasCostos)
                        {
                            <li>
                                <a href="estructuras/@est.Id">@est.Nombre</a>
                                <span class="app-muted"> (@est.FechaCreacion.ToString("dd/MM/yyyy"))</span>
                            </li>
                        }
                    </ul>
                }
            </RadzenCard>
        </RadzenColumn>

        @* ── Certificados ── *@
        <RadzenColumn Size="12">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                             AlignItems="AlignItems.Center" class="rz-mb-2">
                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">Certificados de Avance</RadzenText>
                    <RadzenButton Text="Ver / Gestionar" Icon="receipt_long" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                  Variant="Variant.Flat" Click="@(() => Nav.NavigateTo($"obras/{obra.Id}/certificados"))" />
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.Body2" class="app-muted rz-mb-0">
                    Accedé al historial de certificados y cargá la ejecución mensual.
                </RadzenText>
            </RadzenCard>
        </RadzenColumn>

        @* ── Tablas de Ponderación ── *@
        @if (!obra.TablasPonderacion.Any())
        {
            <RadzenColumn Size="12">
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                                 AlignItems="AlignItems.Center" class="rz-mb-2">
                        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">Tabla de Ponderación</RadzenText>
                        <RadzenButton Text="Crear tabla" Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                      Click="@(() => Nav.NavigateTo($"obras/{obra.Id}/ponderacion"))" />
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Body2" class="app-muted rz-mb-0">
                        Sin tabla de ponderación: la obra no puede calcular redeterminaciones hasta cargarla.
                    </RadzenText>
                </RadzenCard>
            </RadzenColumn>
        }
        @foreach (var tabla in obra.TablasPonderacion)
        {
            <RadzenColumn Size="12">
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                                 AlignItems="AlignItems.Center" class="rz-mb-3">
                        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">Tabla de Ponderación: @tabla.Nombre</RadzenText>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <RadzenButton Text="Editar Tabla" Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                          Variant="Variant.Flat" Click="@(() => Nav.NavigateTo($"obras/{obra.Id}/ponderacion"))" />
                            <RadzenButton Text="Calcular Redeterminación" Icon="calculate" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                          Click="@(() => Nav.NavigateTo($"redeterminacion/calcular?obraId={obra.Id}"))" />
                        </RadzenStack>
                    </RadzenStack>
                    <RadzenDataGrid Data="@tabla.Items" TItem="ItemPonderacionObraVM"
                                    Density="Density.Compact" AllowFiltering="true" FilterMode="FilterMode.CheckBoxList"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowSorting="true"
                                    EmptyText="Ningún registro coincide con los filtros aplicados.">
                        <Columns>
                            <RadzenDataGridColumn TItem="ItemPonderacionObraVM" Property="Numero" Title="N°" Width="60px" TextAlign="TextAlign.Center" />
                            <RadzenDataGridColumn TItem="ItemPonderacionObraVM" Property="Insumo" Title="Insumo" />
                            <RadzenDataGridColumn TItem="ItemPonderacionObraVM" Property="PesoPorcentaje" Title="Peso %" Width="110px"
                                                  FormatString="{0:N2}" TextAlign="TextAlign.Center" />
                            <RadzenDataGridColumn TItem="ItemPonderacionObraVM" Property="DescripcionINDEC" Title="Índice INDEC" />
                        </Columns>
                    </RadzenDataGrid>
                </RadzenCard>
            </RadzenColumn>
        }
    </RadzenRow>
}

@code {
    [Parameter] public int Id { get; set; }

    private ObraDetalleVM? obra;
    private bool noEncontrada;
    private bool procesando;
    private int idCargado;   // 0 = nada cargado; evita recargar si el parámetro no cambió

    private async Task RecargarAsync()
    {
        obra = await ObraService.ObtenerDetalleAsync(Id);
        noEncontrada = obra is null;
    }

    private async Task AgregarProrrogaAsync()
    {
        if (procesando || obra is null) return;

        // Sin fin de contrato no hay qué prorrogar: mismo mensaje que el servicio, sin
        // abrir un diálogo que va a fallar.
        if (ObraValidator.AgregarProrroga(obra.FechaFinalContrato, DateTime.MaxValue) is string motivo)
        {
            Notifications.Notify(NotificationSeverity.Info, "Sin fecha de fin", motivo, 6000);
            return;
        }

        var resultado = await DialogService.OpenAsync<ProrrogaAgregarDialog>(
            $"Prórroga N°{obra.Prorrogas.Count + 1} — {obra.Nombre}",
            new Dictionary<string, object?>
            {
                [nameof(ProrrogaAgregarDialog.ObraId)] = obra.Id,
                [nameof(ProrrogaAgregarDialog.FechaFinVigente)] = obra.FechaFinalContrato!.Value
            },
            new DialogOptions { Width = "min(520px, 92vw)" });

        if (resultado is true)
            await RecargarAsync();
    }

    private async Task EliminarProrrogaAsync(ProrrogaObraVM p)
    {
        if (procesando) return;
        procesando = true;
        try
        {
            await UiAcciones.ConfirmarEliminarYRecargarAsync(DialogService, Notifications,
                $"Eliminar la prórroga N°{p.Numero} restaura el fin de contrato al {p.FechaFinAnterior:dd/MM/yyyy}. ¿Continuar?",
                () => ObraService.EliminarProrrogaAsync(p.Id),
                "Prórroga eliminada", $"Fin de contrato vigente: {p.FechaFinAnterior:dd/MM/yyyy}.",
                "Ya eliminada", "Otro usuario eliminó esta prórroga; se recargó el detalle.",
                RecargarAsync);
        }
        finally { procesando = false; }
    }

    // OnParametersSetAsync (no OnInitializedAsync): Blazor reutiliza el componente
    // cuando sólo cambia el parámetro de ruta (ej. /obras/1 -> /obras/2).
    protected override async Task OnParametersSetAsync()
    {
        if (idCargado == Id) return;
        idCargado = Id;

        // El servicio ya devuelve estructuras (por fecha), ítems y prórrogas (por número) ordenados.
        await RecargarAsync();
    }

    /// <summary>"$ 1.000,00 · US$ 50,00" con solo las monedas cargadas (null si ninguna: el Dato queda vacío).</summary>
    private static string? Importes(decimal? pesos, decimal? usd, decimal? eur)
    {
        var partes = new List<string>();
        if (pesos is > 0) partes.Add($"{Fmt.Simbolo(Moneda.Pesos)} {Fmt.Pesos(pesos.Value)}");
        if (usd is > 0) partes.Add($"{Fmt.Simbolo(Moneda.USD)} {Fmt.Pesos(usd.Value)}");
        if (eur is > 0) partes.Add($"{Fmt.Simbolo(Moneda.EUR)} {Fmt.Pesos(eur.Value)}");
        return partes.Count > 0 ? string.Join(" · ", partes) : null;
    }

    private RenderFragment Dato(string label, string? value) =>@<RadzenRow class="rz-mt-1">
        <RadzenColumn Size="5">
            <RadzenText TextStyle="TextStyle.Body2" class="app-muted rz-mb-0">@label</RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="7">
            <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">@value</RadzenText>
        </RadzenColumn>
    </RadzenRow>;
}
