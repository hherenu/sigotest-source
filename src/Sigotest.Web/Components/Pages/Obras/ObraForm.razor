@page "/obras/nueva"
@page "/obras/{Id:int}/editar"
@attribute [Authorize(Roles = Roles.Certificaciones)]
@inject ObraService ObraService
@inject NavigationManager Nav
@inject NotificationService Notifications

<PageTitle>@Titulo</PageTitle>

@if (noEncontrada)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
        No se encontró la obra solicitada.
    </RadzenAlert>
}
else if (obra is null)
{
    <EstadoCargando Texto="Cargando obra…" />
}
else
{
    <CabeceraPagina Titulo="@Titulo" Estilo="TextStyle.H4" Clase="rz-mb-4" Migas="@Migas" />

    <RadzenTemplateForm TItem="ObraVM" Data="@obra" Submit="@GuardarAsync">
        <RadzenStack Gap="1rem" style="max-width: 960px;">

            <RadzenFieldset Text="Datos Generales">
                <RadzenRow Gap="1rem" RowGap="1rem">
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenFormField Text="Nombre *" Variant="Variant.Outlined" style="width:100%">
                            <RadzenTextBox @bind-Value="obra.Nombre" Name="Nombre" style="width:100%" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="Nombre" Text="El nombre es obligatorio" Popup="true" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="N° Licitación *" Variant="Variant.Outlined" style="width:100%">
                            <RadzenTextBox @bind-Value="obra.NumeroLicitacion" Name="NumeroLicitacion" style="width:100%" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="NumeroLicitacion" Text="La licitación es obligatoria" Popup="true" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Contratista" Variant="Variant.Outlined" style="width:100%">
                            <RadzenTextBox @bind-Value="obra.Contratista" style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Antecedentes (EX)" Variant="Variant.Outlined" style="width:100%"
                                         title="N° de expediente electrónico (EX-…)">
                            <RadzenTextBox @bind-Value="obra.Antecedentes" style="width:100%" />
                        </RadzenFormField>
                        <RadzenText TextStyle="TextStyle.Caption" class="app-muted rz-mt-1 rz-mb-0">
                            Con antecedentes y acta de inicio futura, la obra figura en Proceso Licitatorio y entra en Planificación.
                        </RadzenText>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="PUByC" Variant="Variant.Outlined" style="width:100%">
                            <RadzenTextBox @bind-Value="obra.PUByC" style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>

            <RadzenFieldset Text="Presupuesto">
                <RadzenRow Gap="1rem" RowGap="1rem">
                    <RadzenColumn Size="12" SizeMD="4">
                        @* Obligatorio > 0: el numérico no admite RequiredValidator (nunca es null);
                           lo exige el servicio (ObraValidator.Guardar) con el mismo mensaje. *@
                        <RadzenFormField Text="Presupuesto oficial ($) *" Variant="Variant.Outlined" style="width:100%">
                            <RadzenNumeric @bind-Value="obra.PresupuestoOficial" Min="0" Step="0.01" ShowUpDown="false" style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Presupuesto oficial (US$)" Variant="Variant.Outlined" style="width:100%">
                            <RadzenNumeric TValue="decimal?" @bind-Value="obra.PresupuestoOficialUSD" Min="0" Step="0.01" ShowUpDown="false" style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Presupuesto oficial (€)" Variant="Variant.Outlined" style="width:100%">
                            <RadzenNumeric TValue="decimal?" @bind-Value="obra.PresupuestoOficialEUR" Min="0" Step="0.01" ShowUpDown="false" style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Presupuesto adjudicado ($)" Variant="Variant.Outlined" style="width:100%">
                            <RadzenNumeric TValue="decimal?" @bind-Value="obra.PresupuestoAdjudicado" Min="0" Step="0.01" ShowUpDown="false" style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Presupuesto adjudicado (US$)" Variant="Variant.Outlined" style="width:100%">
                            <RadzenNumeric TValue="decimal?" @bind-Value="obra.PresupuestoAdjudicadoUSD" Min="0" Step="0.01" ShowUpDown="false" style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Presupuesto adjudicado (€)" Variant="Variant.Outlined" style="width:100%">
                            <RadzenNumeric TValue="decimal?" @bind-Value="obra.PresupuestoAdjudicadoEUR" Min="0" Step="0.01" ShowUpDown="false" style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12">
                        <RadzenText TextStyle="TextStyle.Caption" class="app-muted rz-mb-0">
                            La planificación de la Obra Básica se controla contra el adjudicado en todas las monedas
                            si está cargado (una moneda vacía cuenta como 0); si no hay adjudicado, contra el oficial.
                        </RadzenText>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>

            <RadzenFieldset Text="Fechas e IFs">
                <RadzenRow Gap="1rem" RowGap="1rem">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Fecha Oferta" Variant="Variant.Outlined" style="width:100%">
                            <RadzenDatePicker @bind-Value="obra.FechaOferta" DateFormat="dd/MM/yyyy" ShowTime="false" style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenFormField Text="Oferta Final (IF)" Variant="Variant.Outlined" style="width:100%"
                                         title="N° de documento GDE (IF-…)">
                            <RadzenTextBox @bind-Value="obra.OfertaFinal" style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Fecha Adjudicación" Variant="Variant.Outlined" style="width:100%">
                            <RadzenDatePicker @bind-Value="obra.FechaAdjudicacion" DateFormat="dd/MM/yyyy" ShowTime="false" style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenFormField Text="IF Adjudicación" Variant="Variant.Outlined" style="width:100%"
                                         title="N° de documento GDE (IF-…)">
                            <RadzenTextBox @bind-Value="obra.IFAdjudicacion" style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Fecha Contrato" Variant="Variant.Outlined" style="width:100%">
                            <RadzenDatePicker @bind-Value="obra.FechaContrato" DateFormat="dd/MM/yyyy" ShowTime="false" style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenFormField Text="IF Contrato" Variant="Variant.Outlined" style="width:100%"
                                         title="N° de documento GDE (IF-…)">
                            <RadzenTextBox @bind-Value="obra.IFContrato" style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Fecha Acta Inicio" Variant="Variant.Outlined" style="width:100%">
                            <RadzenDatePicker @bind-Value="obra.FechaActaInicio" DateFormat="dd/MM/yyyy" ShowTime="false" style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenFormField Text="IF Acta Inicio" Variant="Variant.Outlined" style="width:100%"
                                         title="N° de documento GDE (IF-…)">
                            <RadzenTextBox @bind-Value="obra.IFActaInicio" style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Fecha Final Contrato" Variant="Variant.Outlined" style="width:100%">
                            <RadzenDatePicker @bind-Value="obra.FechaFinalContrato" DateFormat="dd/MM/yyyy" ShowTime="false" style="width:100%"
                                              Disabled="@obra.TieneProrrogas" />
                        </RadzenFormField>
                        @if (obra.TieneProrrogas)
                        {
                            @* Deshabilitado de verdad (no es una regla de negocio en el clic): el dato
                               lo gobiernan las prórrogas y el servicio conserva el vigente. *@
                            <RadzenText TextStyle="TextStyle.Caption" class="app-muted rz-mt-1 rz-mb-0">
                                Es el fin vigente por prórrogas: se modifica agregando o eliminando prórrogas desde el detalle de la obra.
                            </RadzenText>
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.Caption" class="app-muted rz-mt-1 rz-mb-0">
                                Sin fecha de fin (y sin proceso licitatorio) la obra figura Proyectada y no entra en Planificación.
                            </RadzenText>
                        }
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenFormField Text="Plazo de Obra" Variant="Variant.Outlined" style="width:100%">
                            <RadzenTextBox @bind-Value="obra.PlazoObra" style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        @* La explicación va como caption debajo: dentro del label flotante
                           era una oración entera comprimida en el borde del campo. *@
                        <RadzenFormField Text="Director de Obra (usuario)" Variant="Variant.Outlined" style="width:100%">
                            <RadzenDropDown @bind-Value="obra.DirectorUsuarioId" Data="@directores" TextProperty="Nombre" ValueProperty="Id"
                                            TValue="int?" AllowClear="true" Placeholder="(sin usuario asignado)" style="width:100%" />
                        </RadzenFormField>
                        <RadzenText TextStyle="TextStyle.Caption" class="app-muted rz-mt-1 rz-mb-0">
                            Recibe las notificaciones de planificación.
                        </RadzenText>
                    </RadzenColumn>
                    @if (obra.DirectorUsuarioId is null)
                    {
                        @* Texto libre interino para obras cuyo director no es usuario de la app
                           (ver Obra.DirectorUsuarioId); con usuario asignado, ese nombre manda. *@
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Director (texto libre, sin usuario)" Variant="Variant.Outlined" style="width:100%">
                                <RadzenTextBox @bind-Value="obra.DirectorObra" style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                    }
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="IF Designación" Variant="Variant.Outlined" style="width:100%"
                                         title="N° de documento GDE (IF-…)">
                            <RadzenTextBox @bind-Value="obra.IFDesignacion" style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton ButtonType="ButtonType.Submit" Text="Guardar" Icon="save" ButtonStyle="ButtonStyle.Primary"
                              IsBusy="@guardando" BusyText="Guardando..." />
                <RadzenButton Text="Cancelar" Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                              Click="@(() => Nav.NavigateTo("obras"))" />
            </RadzenStack>
        </RadzenStack>
    </RadzenTemplateForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private ObraVM? obra;
    private bool noEncontrada;
    private bool guardando;

    private string Titulo => Id is null ? "Nueva Obra" : "Editar Obra";

    // En @code y no inline en el atributo: la expresión multilínea dentro del
    // markup confundía al analizador Razor del IDE (falsos "Invalid expression").
    private CabeceraPagina.Miga[] Migas => Id is null
        ? [new("Obras", "obras"), new("Nueva")]
        : [new("Obras", "obras"), new(obra?.Nombre ?? "Obra", $"obras/{Id}"), new("Editar")];

    private bool cargado;
    private int? idCargado;
    private List<DirectorCandidatoVM> directores = new();

    // OnParametersSetAsync: el componente se reutiliza si sólo cambia el parámetro de ruta.
    protected override async Task OnParametersSetAsync()
    {
        if (cargado && idCargado == Id) return;
        cargado = true;
        idCargado = Id;

        directores = await ObraService.CandidatosDirectorAsync(Id);

        if (Id is null)
        {
            obra = new ObraVM();
            noEncontrada = false;
        }
        else
        {
            obra = await ObraService.ObtenerAsync(Id.Value);
            noEncontrada = obra is null;
        }
    }

    private async Task GuardarAsync()
    {
        if (obra is null || guardando) return;

        guardando = true;
        try
        {
            await UiAcciones.GuardarYNavegarAsync(Notifications, Nav,
                () => Id is null ? ObraService.CrearAsync(obra) : ObraService.ActualizarAsync(obra),
                "Obra guardada", () => obra.Nombre, () => "obras");
        }
        finally { guardando = false; }
    }
}
