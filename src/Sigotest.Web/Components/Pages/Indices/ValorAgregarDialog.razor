@inject IndiceService Service
@inject DialogService DialogService
@inject NotificationService Notifications

@* Alta de valor mensual de /indices/{id}/valores en diálogo (antes panel lateral:
   robaba un tercio del ancho a la grilla para un alta que ocurre una vez al mes).
   Cierra con true si agregó (el llamador recarga la lista); ante un duplicado
   avisa y queda abierto para corregir. *@

<RadzenTemplateForm TItem="NuevoValorVM" Data="@nuevo" Submit="@AgregarAsync">
    <RadzenStack Gap="0.75rem">
        @* Año y valor: las reglas de IndiceValidator que exige el servicio, evaluadas tal cual y
           con el mismo mensaje. Sin Min/Max en los numéricos: Radzen lleva el valor tipeado al
           límite sin avisar (un año 1999 se guardaba como 2000). *@
        <div>
            <RadzenFormField Text="Año" Variant="Variant.Outlined" style="width:100%">
                <RadzenNumeric @bind-Value="nuevo.Anio" Name="Anio" ShowUpDown="false" style="width:100%" />
            </RadzenFormField>
            <RadzenCustomValidator Component="Anio" Validator="@(() => IndiceValidator.Anio(nuevo.Anio) is null)"
                                   Text="@IndiceValidator.AnioFueraDeRango" Popup="true" />
        </div>
        <RadzenFormField Text="Mes" Variant="Variant.Outlined" style="width:100%">
            <RadzenDropDown @bind-Value="nuevo.Mes" Data="@(Enumerable.Range(1, 12))" TValue="int" style="width:100%">
                <Template Context="m">@Fmt.MesNombre(m)</Template>
            </RadzenDropDown>
        </RadzenFormField>
        <div>
            <RadzenFormField Text="Valor *" Variant="Variant.Outlined" style="width:100%">
                <RadzenNumeric @bind-Value="nuevo.Valor" Name="Valor" Step="0.0001" ShowUpDown="false" style="width:100%" />
            </RadzenFormField>
            @* Vacío tampoco pasa la regla: un solo aviso, el mismo que da el servicio. *@
            <RadzenCustomValidator Component="Valor" Validator="@(() => IndiceValidator.ValorMensual(nuevo.Valor) is null)"
                                   Text="@IndiceValidator.ValorNoPositivo" Popup="true" />
        </div>
        @* La regla del servicio (IndiceValidator.PublicacionAltaManual), con su mensaje: vacío
           pasa; si viene, con el formato de la importación. Las tasas van sin publicación. *@
        @if (EsTasas)
        {
            <RadzenText TextStyle="TextStyle.Caption" class="app-muted rz-mb-0">Las tasas del Banco Nación se cargan sin publicación.</RadzenText>
        }
        else
        {
            <div>
                <RadzenFormField Text="ID Publicación" Variant="Variant.Outlined" style="width:100%">
                    <RadzenTextBox @bind-Value="nuevo.IdPublicacion" Name="IdPublicacion" Placeholder="Ej: INDEC_INFORMA_04_26"
                                   MaxLength="LargoTexto.PorDefecto" style="width:100%" />
                </RadzenFormField>
                <RadzenCustomValidator Component="IdPublicacion" Validator="@(() => ErrorPublicacion is null)"
                                       Text="@(ErrorPublicacion ?? "")" Popup="true" />
            </div>
        }
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
            <RadzenButton Text="Cancelar" Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                          Click="@(() => DialogService.Close(false))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="Agregar" Icon="add" ButtonStyle="ButtonStyle.Primary"
                          IsBusy="@procesando" BusyText="Agregando..." />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public int IndiceId { get; set; }
    [Parameter] public string? CodigoIndice { get; set; }

    private NuevoValorVM nuevo = new();
    private bool procesando;

    private bool EsTasas => IndiceService.EsTasasBancoNacion(CodigoIndice);
    private string? ErrorPublicacion => IndiceValidator.PublicacionAltaManual(nuevo.IdPublicacion, EsTasas);

    protected override void OnInitialized() =>
        nuevo = new NuevoValorVM { Anio = DateTime.Now.Year, Mes = DateTime.Now.Month };

    private async Task AgregarAsync()
    {
        if (procesando) return;
        procesando = true;
        try
        {
            var pub = IndiceService.NormalizarPublicacion(nuevo.IdPublicacion);
            var duplicado = false;
            var hecho = await Persistencia.EjecutarAsync(async () =>
            {
                // La regla de duplicado por publicación vive en el servicio (espeja
                // los índices únicos de la DB): false = ya existía, no es un error.
                duplicado = !await Service.AgregarValorAsync(IndiceId, nuevo);
            }, Notifications);

            if (duplicado)
            {
                Notifications.Notify(NotificationSeverity.Warning, "Duplicado",
                    pub is null
                        ? $"Ya existe un valor sin publicación para ese índice en {nuevo.Mes}/{nuevo.Anio}."
                        : $"Ya existe un valor para ese índice en {nuevo.Mes}/{nuevo.Anio} con la publicación {pub}.", 6000);
                return;
            }
            if (!hecho) return;

            Notifications.Notify(NotificationSeverity.Success, "Valor agregado",
                $"{Fmt.MesNombre(nuevo.Mes)} {nuevo.Anio}", 3000);
            DialogService.Close(true);
        }
        finally { procesando = false; }
    }
}
