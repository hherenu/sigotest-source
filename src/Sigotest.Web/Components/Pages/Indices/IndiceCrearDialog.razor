@inject IndiceService Service
@inject DialogService DialogService
@inject NotificationService Notifications

@* Alta rápida de un índice desde la vista previa de la importación: la fila salió
   "Código desconocido" y el usuario lo agrega al catálogo sin abandonar el pegado
   (navegar a /indices/nuevo perdería el texto y el análisis). El código detectado
   viene precargado como Código ID, que es la clave del pegado; el llamador re-analiza
   al cerrar con true para que las filas de ese código pasen a "A importar". *@

<RadzenTemplateForm TItem="IndiceVM" Data="@indice" Submit="@GuardarAsync">
    <RadzenStack Gap="0.75rem">
        <div>
            @* Solo lectura: el diálogo resuelve ESA fila del pegado. Si el código se pudiera
               retocar, se crearía otro índice y la fila seguiría «Código desconocido» (y el
               catálogo no tiene edición ni baja). Si el código del Excel está mal, se corrige
               el Excel, no el catálogo. *@
            <RadzenFormField Text="Código ID (tal como vino en el pegado) *" Variant="Variant.Outlined" style="width:100%">
                <RadzenTextBox @bind-Value="indice.CodigoIndice" Name="CodigoIndice" ReadOnly="true" style="width:100%" />
            </RadzenFormField>
            <RadzenRequiredValidator Component="CodigoIndice" Text="El código es obligatorio" Popup="true" />
        </div>
        <div>
            <RadzenFormField Text="Familia de Recurso (nombre en las tablas de ponderación) *" Variant="Variant.Outlined" style="width:100%">
                <RadzenTextBox @bind-Value="indice.FamiliaRecurso" Name="FamiliaRecurso" style="width:100%" />
            </RadzenFormField>
            <RadzenRequiredValidator Component="FamiliaRecurso" Text="La familia de recurso es obligatoria" Popup="true" />
        </div>
        <RadzenFormField Text="Índice Normalizado (informativo)" Variant="Variant.Outlined" style="width:100%">
            <RadzenTextBox @bind-Value="indice.IndiceNormalizado" style="width:100%" />
        </RadzenFormField>
        @* Los ejemplos van en Helper: Radzen no renderiza Placeholder dentro de un FormField. *@
        <RadzenRow Gap="0.75rem">
            <RadzenColumn Size="12" SizeMD="8">
                <RadzenFormField Text="Cuadro de Referencia (informativo)" Variant="Variant.Outlined" style="width:100%">
                    <ChildContent><RadzenTextBox @bind-Value="indice.CuadroReferencia" style="width:100%" /></ChildContent>
                    <Helper><RadzenText TextStyle="TextStyle.Caption" class="app-muted rz-mb-0">Ej: 71240 - 11</RadzenText></Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenFormField Text="Inciso (informativo)" Variant="Variant.Outlined" style="width:100%">
                    <ChildContent><RadzenTextBox @bind-Value="indice.IncisoCode" style="width:100%" /></ChildContent>
                    <Helper><RadzenText TextStyle="TextStyle.Caption" class="app-muted rz-mb-0">Ej: e</RadzenText></Helper>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
        <RadzenText TextStyle="TextStyle.Body2" class="app-muted rz-mb-0">
            El código <b>@CodigoDetectado</b> no existe en el catálogo: se crea con ese Código ID, tal como
            vino en el pegado. Completá la Familia de Recurso y, al guardar, el pegado se vuelve a analizar.
        </RadzenText>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
            <RadzenButton Text="Cancelar" Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                          Click="@(() => DialogService.Close(false))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="Guardar" Icon="save" ButtonStyle="ButtonStyle.Primary"
                          IsBusy="@procesando" BusyText="Guardando..." />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    /// <summary>Código que el análisis no encontró en el catálogo (tal como viajó en la fila).</summary>
    [Parameter] public string CodigoDetectado { get; set; } = string.Empty;

    private IndiceVM indice = new();
    private bool procesando;

    protected override void OnInitialized()
    {
        indice = new IndiceVM { CodigoIndice = CodigoDetectado };
    }

    private async Task GuardarAsync()
    {
        if (procesando) return;
        procesando = true;
        try
        {
            var hecho = await Persistencia.EjecutarAsync(
                () => Service.CrearAsync(indice), Notifications);
            if (!hecho) return;

            Notifications.Notify(NotificationSeverity.Success, "Índice creado",
                indice.CodigoIndice.Trim(), 3000);
            DialogService.Close(true);
        }
        finally { procesando = false; }
    }
}
