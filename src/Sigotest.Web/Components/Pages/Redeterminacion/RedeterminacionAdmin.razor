@page "/redeterminacion/{Id:int}/admin"
@attribute [Authorize(Roles = Roles.Certificaciones)]
@inject RedeterminacionService Service
@inject NavigationManager Nav
@inject NotificationService Notifications

<PageTitle>@(vm is null ? "Datos administrativos" : $"Admin — Disparo {vm.NroDisparo}")</PageTitle>

@if (noEncontrado)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
        No se encontró el cálculo solicitado.
    </RadzenAlert>
}
else if (vm is null)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
}
else
{
    <CabeceraPagina Titulo="@($"Disparo N° {vm.NroDisparo} — Datos Administrativos")">
        <Subtitulo>
            @vm.ObraNombre · Mes Salto: @Fmt.MesCorto(vm.MesSalto) @vm.AnioSalto · Variación:
            <span style="@($"font-weight:700;color:{Redet.ColorSuba(vm.PorcentajeAumento)}")">@vm.PorcentajeAumento?.ToString("N4")%</span>
        </Subtitulo>
        <Acciones>
            <RadzenButton Text="Historial" Icon="arrow_back" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                          Click="@(() => Nav.NavigateTo($"redeterminacion/historial?obraId={vm.ObraId}"))" />
        </Acciones>
    </CabeceraPagina>

    <RadzenCard Variant="Variant.Outlined" style="max-width:560px">
        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-3" style="font-weight:600">Expediente y Aprobaciones</RadzenText>
        <RadzenTemplateForm TItem="RedeterminacionAdminVM" Data="@vm" Submit="@GuardarAsync">
            <RadzenStack Gap="1rem">
                <RadzenFormField Text="N° Expediente VR" Variant="Variant.Outlined" style="width:100%">
                    <RadzenTextBox @bind-Value="vm.NroExpedienteVR" Placeholder="EX-2025-XXXXXXXX-GCABA-SBASE" style="width:100%" />
                </RadzenFormField>
                <RadzenFormField Text="Fecha Aprobación CCyR" Variant="Variant.Outlined" style="width:100%">
                    <RadzenDatePicker @bind-Value="vm.FechaAprobacionCCyR" DateFormat="dd/MM/yyyy" ShowTime="false" style="width:100%" />
                </RadzenFormField>
                <RadzenFormField Text="Fecha Aprobación por OS" Variant="Variant.Outlined" style="width:100%">
                    <RadzenDatePicker @bind-Value="vm.FechaAprobacionOS" DateFormat="dd/MM/yyyy" ShowTime="false" style="width:100%" />
                </RadzenFormField>
                <RadzenFormField Text="Fecha Límite Presentación Red. Def." Variant="Variant.Outlined" style="width:100%">
                    <RadzenDatePicker @bind-Value="vm.FechaLimitePresentacion" DateFormat="dd/MM/yyyy" ShowTime="false" style="width:100%" />
                </RadzenFormField>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton ButtonType="ButtonType.Submit" Text="Guardar" Icon="save" ButtonStyle="ButtonStyle.Primary"
                                  IsBusy="@guardando" BusyText="Guardando..." />
                    <RadzenButton Text="Cancelar" Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                                  Click="@(() => Nav.NavigateTo($"redeterminacion/historial?obraId={vm.ObraId}"))" />
                </RadzenStack>
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
}

@code {
    [Parameter] public int Id { get; set; }

    // El form bindea el VM administrativo (no la entidad EF): el guardado pasa por
    // RedeterminacionService.GuardarDatosAdminAsync con el RowVersion como token.
    private RedeterminacionAdminVM? vm;
    private bool noEncontrado;
    private bool guardando;

    private int idCargado;

    protected override async Task OnParametersSetAsync()
    {
        if (idCargado == Id) return;
        idCargado = Id;

        vm = await Service.BuildAdminVmAsync(Id);
        noEncontrado = vm is null;
    }

    private async Task GuardarAsync()
    {
        if (vm is null || guardando) return;

        guardando = true;
        try
        {
            await UiAcciones.GuardarYNavegarAsync(Notifications, Nav,
                () => Service.GuardarDatosAdminAsync(Id, vm, vm.RowVersion),
                "Guardado", () => "Datos administrativos actualizados.",
                () => $"redeterminacion/historial?obraId={vm.ObraId}");
        }
        finally { guardando = false; }
    }
}
