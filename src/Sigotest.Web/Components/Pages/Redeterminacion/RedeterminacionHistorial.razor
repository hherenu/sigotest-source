@page "/redeterminacion/historial"
@attribute [Authorize(Roles = Roles.Certificaciones)]
@inject NavigationManager Nav
@inject DialogService DialogService
@inject NotificationService Notifications
@inject RedeterminacionService Service

<PageTitle>Historial de Redeterminaciones</PageTitle>

@* Mismo nombre que el menú y el PageTitle; el término de dominio ("variaciones de
   referencia") se conserva en el subtítulo para los usuarios que lo buscan así. *@
<CabeceraPagina Titulo="Historial de Redeterminaciones" Estilo="TextStyle.H4">
    <Subtitulo>Variaciones de referencia guardadas, agrupadas por obra</Subtitulo>
    <Acciones>
        <RadzenButton Text="Calcular" Icon="calculate" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                      Click="@(() => Nav.NavigateTo("redeterminacion/calcular"))" />
    </Acciones>
</CabeceraPagina>

<RadzenDropDown @bind-Value="filterObraId" Data="@obras" TextProperty="Nombre" ValueProperty="Id" TValue="int?"
                AllowClear="true" Placeholder="-- Todas las obras --" style="width:100%;max-width:420px" class="rz-mb-3"
                Change="@OnFiltroChanged" />

@if (lista is null)
{
    <EstadoCargando Texto="Cargando historial…" />
}
else if (lista.Count == 0)
{
    <EstadoVacio Icono="history"
                 Titulo="@(filterObraId.HasValue ? "No hay cálculos guardados para esta obra" : "No hay cálculos guardados")"
                 Descripcion="Los cálculos guardados desde Calcular Redeterminación aparecen acá como disparos por obra.">
        <Accion>
            @if (filterObraId.HasValue)
            {
                <RadzenButton Text="Ver todas las obras" Icon="filter_alt_off" Size="ButtonSize.Small"
                              ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                              Click="@(() => Nav.NavigateTo("redeterminacion/historial", replace: true))" />
            }
            <RadzenButton Text="Calcular Redeterminación" Icon="calculate" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => Nav.NavigateTo("redeterminacion/calcular"))" />
        </Accion>
    </EstadoVacio>
}
else
{
    @foreach (var grupo in lista.GroupBy(r => r.ObraId))
    {
        var obra = grupo.First();
        var ultimoDisparo = grupo.Max(x => x.NroDisparo);
        // Cada columna administrativa se muestra solo si algún disparo del grupo tiene
        // ESE dato (visibilidad por columna, no por grupo: el historial importado trae
        // fechas de aprobación sin expediente, y en bloque la columna Expediente
        // quedaba siempre visible en "—"). Se editan/ven siempre por el diálogo.
        var verExpediente = grupo.Any(x => !string.IsNullOrWhiteSpace(x.NroExpedienteVR));
        var verCCyR = grupo.Any(x => x.FechaAprobacionCCyR is not null);
        var verOS = grupo.Any(x => x.FechaAprobacionOS is not null);
        var verLimite = grupo.Any(x => x.FechaLimitePresentacion is not null);
        <RadzenCard @key="grupo.Key" Variant="Variant.Outlined" class="rz-mb-4">
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-3" style="font-weight:600">@obra.ObraNumeroLicitacion — @obra.ObraNombre</RadzenText>
            <div class="cert-scroll">
                <table class="cert-grid">
                    <caption class="sr-only">Disparos de redeterminación de @obra.ObraNombre</caption>
                    <thead>
                        <tr>
                            <th scope="col">Disparo N°</th>
                            <th scope="col">Mes de Disparo</th>
                            <th scope="col" title="Variación de referencia respecto del mes base (habilita redeterminación desde el @(Redet.SaltoMinimo.ToString("N0"))%)">Variación Ref. %</th>
                            <th scope="col" title="Coeficiente total Kᵢ/K₀ del salto">Coef. (K/K₀)</th>
                            <th scope="col" title="Variación acumulada de la cadena de disparos">Var. Acumulada</th>
                            <th scope="col">Publicación</th>
                            @if (verExpediente)
                            {
                                <th scope="col" title="N° de expediente de la Variación de Referencia">N° Expediente VR</th>
                            }
                            @if (verCCyR)
                            {
                                <th scope="col" title="Fecha de aprobación CCyR">Aprob. CCyR</th>
                            }
                            @if (verOS)
                            {
                                <th scope="col" title="Fecha de aprobación OS">Aprob. OS</th>
                            }
                            @if (verLimite)
                            {
                                <th scope="col" title="Fecha límite de presentación de la redeterminación definitiva">Límite Red. Def.</th>
                            }
                            <th scope="col">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in grupo.OrderBy(x => x.NroDisparo))
                        {
                            <tr @key="r.Id" style="text-align:center">
                                <td style="font-weight:700">@r.NroDisparo</td>
                                <td>@Fmt.MesCorto(r.MesSalto)-@(r.AnioSalto % 100)</td>
                                <td style="white-space:nowrap">
                                    @if (r.PorcentajeAumento.HasValue)
                                    {
                                        @* Badge con texto además del color: el rojo significa "no llega
                                           al salto mínimo", no "variación negativa", y sin texto se
                                           malinterpretaba (y era invisible para daltónicos). *@
                                        <span style="@($"font-weight:700;color:{Redet.ColorSuba(r.PorcentajeAumento)}")">@r.PorcentajeAumento.Value.ToString("N4")%</span>
                                        <RadzenBadge Text="@(Redet.EsSuba(r.PorcentajeAumento) ? "Habilita" : "No habilita")" IsPill="true"
                                                     BadgeStyle="@(Redet.EsSuba(r.PorcentajeAumento) ? BadgeStyle.Success : BadgeStyle.Danger)"
                                                     Shade="Shade.Lighter" class="rz-ml-1" />
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>@r.TotalKiK0?.ToString("N2")</td>
                                <td style="font-weight:600">@r.VariacionAcumulada?.ToString("N2")</td>
                                <td>@Fmt.PubMayus(r.IdPublicacionSalto ?? r.IdPublicacionBase)</td>
                                @if (verExpediente)
                                {
                                    <td style="text-align:left">@(string.IsNullOrWhiteSpace(r.NroExpedienteVR) ? "—" : r.NroExpedienteVR)</td>
                                }
                                @if (verCCyR)
                                {
                                    <td>@r.FechaAprobacionCCyR?.ToString("d/M/yyyy")</td>
                                }
                                @if (verOS)
                                {
                                    <td>@r.FechaAprobacionOS?.ToString("d/M/yyyy")</td>
                                }
                                @if (verLimite)
                                {
                                    <td>@r.FechaLimitePresentacion?.ToString("d/M/yyyy")</td>
                                }
                                <td style="white-space:nowrap">
                                    <RadzenButton Icon="visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info" Variant="Variant.Text"
                                                  title="Ver" Click="@(() => Nav.NavigateTo($"redeterminacion/{r.Id}"))" />
                                    <RadzenButton Icon="calculate" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Text"
                                                  title="@(EsRecalculable(r) ? "Recalcular" : $"En estado {r.Estado} no admite recálculo")"
                                                  Disabled="@(!EsRecalculable(r))"
                                                  Click="@(() => Nav.NavigateTo($"redeterminacion/calcular?editarId={r.Id}"))" />
                                    @* Primary como todos los "editar" de fila (era Warning, único en la app). *@
                                    <RadzenButton Icon="edit_note" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text"
                                                  title="Datos administrativos" Click="@(() => AbrirAdminAsync(r))" />
                                    <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                                  title="@(r.NroDisparo != ultimoDisparo ? "Solo se puede eliminar el último disparo"
                                                          : !EsRecalculable(r) ? $"En estado {r.Estado} no puede eliminarse" : "Eliminar")"
                                                  Disabled="@(procesando || r.NroDisparo != ultimoDisparo || !EsRecalculable(r))"
                                                  Click="@(() => EliminarAsync(r))" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </RadzenCard>
    }
}

@code {
    [Parameter, SupplyParameterFromQuery] public int? ObraId { get; set; }

    private List<ObraOpcionVM> obras = new();
    private int? filterObraId;
    private List<RedeterminacionHistorialVM>? lista;
    private bool procesando;

    private bool paramsCargados;
    private int? obraIdCargada;

    // Carga única (no depende del parámetro).
    protected override async Task OnInitializedAsync() =>
        obras = await Service.GetObrasAsync();

    // Depende del query param: se re-ejecuta si cambia ?obraId=
    protected override async Task OnParametersSetAsync()
    {
        if (paramsCargados && obraIdCargada == ObraId) return;
        paramsCargados = true;
        obraIdCargada = ObraId;

        filterObraId = ObraId;
        await CargarAsync();
    }

    // El filtro vive en la URL (?obraId=): F5 y "atrás" restauran lo que se está viendo.
    // Navegar dispara OnParametersSetAsync, que recarga con el nuevo filtro.
    private void OnFiltroChanged() =>
        Nav.NavigateTo(filterObraId.HasValue
            ? $"redeterminacion/historial?obraId={filterObraId}"
            : "redeterminacion/historial", replace: true);

    private async Task CargarAsync() =>
        lista = await Service.GetHistorialAsync(filterObraId);

    // Espejo UI de RedeterminacionValidator (la regla completa vive en el servicio).
    private static bool EsRecalculable(RedeterminacionHistorialVM r) =>
        RedeterminacionValidator.EsRecalculable(r.Estado);

    // El VM se carga acá y no en el diálogo: si el disparo ya no existe (lo borró otro
    // usuario) se avisa y se recarga la grilla sin abrir nada.
    private async Task AbrirAdminAsync(RedeterminacionHistorialVM r)
    {
        var vm = await Service.BuildAdminVmAsync(r.Id);
        if (vm is null)
        {
            Notifications.Notify(NotificationSeverity.Warning, "No encontrado", "El cálculo ya no existe.", 4000);
            await CargarAsync();
            return;
        }

        var resultado = await DialogService.OpenAsync<RedeterminacionAdminDialog>(
            $"Disparo N° {vm.NroDisparo} — Datos Administrativos",
            new Dictionary<string, object?> { [nameof(RedeterminacionAdminDialog.Vm)] = vm },
            new DialogOptions { Width = "480px" });

        if (resultado is true)
            await CargarAsync();
    }

    private async Task EliminarAsync(RedeterminacionHistorialVM r)
    {
        if (procesando) return;
        procesando = true;
        try
        {
            await UiAcciones.ConfirmarEliminarYRecargarAsync(DialogService, Notifications,
                $"¿Eliminar disparo {r.NroDisparo}?",
                () => Service.EliminarDisparoAsync(r.Id, r.RowVersion),
                "Eliminado", $"Disparo {r.NroDisparo}",
                "Ya eliminado", $"El disparo {r.NroDisparo} ya había sido eliminado por otro usuario.",
                CargarAsync);
        }
        finally { procesando = false; }
    }
}
