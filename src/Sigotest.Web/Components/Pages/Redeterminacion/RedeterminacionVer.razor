@page "/redeterminacion/{Id:int}"
@attribute [Authorize(Roles = Roles.Certificaciones)]
@inject RedeterminacionService Service
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(r is null ? "Cálculo guardado" : $"Cálculo — {r.ObraNombre}")</PageTitle>

@if (noEncontrado)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
        No se encontró el cálculo solicitado.
    </RadzenAlert>
}
else if (r is null)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
}
else
{
    <CabeceraPagina Titulo="Cálculo guardado" Estilo="TextStyle.H4">
        <Acciones>
            <RadzenButton Text="Historial" Icon="arrow_back" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                          Click="@(() => Nav.NavigateTo($"redeterminacion/historial?obraId={r.ObraId}"))" />
        </Acciones>
    </CabeceraPagina>

    <RadzenRow Gap="1rem" RowGap="1rem" class="rz-mb-4">
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenCard Variant="Variant.Outlined" style="height:100%">
                <RadzenText TextStyle="TextStyle.Subtitle2" class="app-muted rz-mb-2">Obra</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-1" style="font-weight:600">@r.ObraNombre</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="app-muted rz-mb-0">@r.ObraNumeroLicitacion</RadzenText>
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenCard Variant="Variant.Outlined" style="height:100%">
                <RadzenText TextStyle="TextStyle.Subtitle2" class="app-muted rz-mb-2">Período</RadzenText>
                <RadzenRow><RadzenColumn Size="5"><RadzenText TextStyle="TextStyle.Caption" class="app-muted">Mes Base (K₀)</RadzenText></RadzenColumn><RadzenColumn Size="7"><RadzenText TextStyle="TextStyle.Caption">@Fmt.PubLabelRevista(r.IdPublicacionBase, r.MesBase, r.AnioBase)</RadzenText></RadzenColumn></RadzenRow>
                <RadzenRow><RadzenColumn Size="5"><RadzenText TextStyle="TextStyle.Caption" class="app-muted">Mes Salto (Kᵢ)</RadzenText></RadzenColumn><RadzenColumn Size="7"><RadzenText TextStyle="TextStyle.Caption">@Fmt.PubLabelRevista(r.IdPublicacionSalto, r.MesSalto, r.AnioSalto)</RadzenText></RadzenColumn></RadzenRow>
                <RadzenRow><RadzenColumn Size="5"><RadzenText TextStyle="TextStyle.Caption" class="app-muted">Guardado</RadzenText></RadzenColumn><RadzenColumn Size="7"><RadzenText TextStyle="TextStyle.Caption">@r.FechaGuardado.ToString("dd/MM/yyyy HH:mm")</RadzenText></RadzenColumn></RadzenRow>
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenCard Variant="Variant.Outlined" style="@($"height:100%;border-color:{ColorSuba}")">
                <RadzenText TextStyle="TextStyle.Subtitle2" class="app-muted rz-text-align-center rz-mb-2">Resultado</RadzenText>
                @if (r.PorcentajeAumento.HasValue)
                {
                    <RadzenText TextStyle="TextStyle.H3" class="rz-text-align-center rz-mb-0"
                                style="@($"color:{ColorSuba};font-weight:700")">@r.PorcentajeAumento.Value.ToString("N4")%</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="app-muted rz-text-align-center">Coeficiente: @r.TotalKiK0?.ToString("N2")</RadzenText>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-text-align-center" style="color:var(--rz-warning)">Faltan valores de índices</RadzenText>
                }
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard Variant="Variant.Outlined" id="print-section">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                     AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Gap="0.5rem" class="rz-mb-3">
            <div>
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0" style="font-weight:600;display:inline">Tabla de Ponderación — @r.ObraNombre</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="app-muted" style="display:inline;margin-left:.5rem">@($"{Fmt.MesCorto(r.MesBase)} {r.AnioBase}") → @($"{Fmt.MesCorto(r.MesSalto)} {r.AnioSalto}")</RadzenText>
            </div>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="d-print-none">
                <RadzenButton Text="Excel" Icon="download" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                              Click="@(() => Nav.NavigateTo($"/Redeterminacion/DescargarExcelGuardado/{r.Id}", true))" />
                <RadzenButton Text="PDF" Icon="print" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                              Click="@(async () => await JS.InvokeVoidAsync("window.print"))" />
            </RadzenStack>
        </RadzenStack>
        <TablaPonderacionCalculo EtiquetaBase="@($"{Fmt.MesCorto(r.MesBase)} {r.AnioBase}")"
                                 EtiquetaSalto="@($"{Fmt.MesCorto(r.MesSalto)} {r.AnioSalto}")"
                                 TotalKiK0="@r.TotalKiK0" PorcentajeAumento="@r.PorcentajeAumento"
                                 Filas="@r.Items.OrderBy(i => i.Numero).Select(i => new TablaPonderacionCalculo.FilaPonderacion(
                                     i.Numero, i.Insumo, i.PesoPorcentaje, i.ValorMesBase, i.ValorMesSalto,
                                     i.KiK0, i.VariacionPonderada, i.DescripcionINDEC))" />
    </RadzenCard>
}

@code {
    [Parameter] public int Id { get; set; }

    private RedeterminacionDetalleVM? r;
    private bool noEncontrado;

    private string ColorSuba => Redet.ColorSuba(r?.PorcentajeAumento);

    private int idCargado;

    protected override async Task OnParametersSetAsync()
    {
        if (idCargado == Id) return;
        idCargado = Id;

        r = await Service.GetDetalleAsync(Id);
        noEncontrado = r is null;
    }
}
