@page "/obras/{ObraId:int}/certificados/nuevo"
@attribute [Authorize(Roles = Roles.Certificaciones)]
@inject CertificadoService Service
@inject NavigationManager Nav
@inject NotificationService Notifications

<PageTitle>Nuevo Certificado</PageTitle>

@if (noEncontrada)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
        No se encontró la obra solicitada.
    </RadzenAlert>
}
else if (alta is null)
{
    <EstadoCargando Texto="Preparando el alta…" />
}
else
{
    <CabeceraPagina Titulo="Nuevo Certificado" Clase="rz-mb-4"
                    Migas="@(new CabeceraPagina.Miga[] { new("Obras", "obras"), new(alta.ObraNombre, $"obras/{ObraId}"), new("Certificados", $"obras/{ObraId}/certificados"), new("Nuevo") })">
        <Subtitulo>@alta.ObraNombre — @alta.NumeroLicitacion</Subtitulo>
    </CabeceraPagina>

    <RadzenTemplateForm TItem="CertificadoNuevoVM" Data="@alta.Form" Submit="@GuardarAsync">
        <RadzenStack Gap="1rem" style="max-width: 640px;">
            <RadzenRow Gap="1rem" RowGap="1rem">
                @* Número y año: las reglas de CertificadoValidator que exige el servicio (Alta),
                   evaluadas tal cual y con el mismo mensaje. Sin Min/Max en los numéricos: Radzen
                   lleva el valor tipeado al límite sin avisar (un año anterior al mínimo se guardaba
                   como el mínimo); el validador muestra el motivo y rechaza el 0 de un campo vaciado. *@
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="N° Certificado *" Variant="Variant.Outlined" style="width:100%">
                        <RadzenNumeric @bind-Value="alta.Form.Numero" Name="Numero" ShowUpDown="false" style="width:100%" />
                    </RadzenFormField>
                    <RadzenCustomValidator Component="Numero" Validator="@(() => CertificadoValidator.Numero(alta.Form.Numero) is null)"
                                           Text="@CertificadoValidator.NumeroInvalido" Popup="true" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Mes *" Variant="Variant.Outlined" style="width:100%">
                        <RadzenDropDown @bind-Value="alta.Form.Mes" Data="@(Enumerable.Range(1, 12))" TValue="int" style="width:100%">
                            <Template Context="m">@Fmt.MesNombre(m)</Template>
                        </RadzenDropDown>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Año *" Variant="Variant.Outlined" style="width:100%">
                        <RadzenNumeric @bind-Value="alta.Form.Anio" Name="Anio" ShowUpDown="false" style="width:100%" />
                    </RadzenFormField>
                    <RadzenCustomValidator Component="Anio" Validator="@(() => CertificadoValidator.Anio(alta.Form.Anio) is null)"
                                           Text="@CertificadoValidator.AnioFueraDeRango" Popup="true" />
                </RadzenColumn>
            </RadzenRow>

            <div>
                <RadzenFormField Text="Estructura de Costos *" Variant="Variant.Outlined" style="width:100%">
                    <RadzenDropDown @bind-Value="alta.Form.EstructuraCostosId" Name="Estructura" Data="@alta.Estructuras" TextProperty="Nombre" ValueProperty="Id"
                                    TValue="int" style="width:100%" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="Estructura" DefaultValue="0" Text="Seleccioná la estructura de costos" Popup="true" />
            </div>

            <RadzenFormField Text="Fecha de Emisión *" Variant="Variant.Outlined" style="width:100%">
                <RadzenDatePicker @bind-Value="alta.Form.FechaEmision" DateFormat="dd/MM/yyyy" ShowTime="false" style="width:100%" />
            </RadzenFormField>

            <RadzenFormField Text="Observaciones" Variant="Variant.Outlined" style="width:100%">
                <RadzenTextArea @bind-Value="alta.Form.Observaciones" MaxLength="LargoTexto.Observaciones" Rows="2" style="width:100%" />
            </RadzenFormField>

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton ButtonType="ButtonType.Submit" Text="Crear y cargar ejecución" Icon="save" ButtonStyle="ButtonStyle.Primary"
                              IsBusy="@guardando" BusyText="Creando..." />
                <RadzenButton Text="Cancelar" Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                              Click="@(() => Nav.NavigateTo($"obras/{ObraId}/certificados"))" />
            </RadzenStack>
        </RadzenStack>
    </RadzenTemplateForm>
}

@code {
    [Parameter] public int ObraId { get; set; }

    // La página bindea el VM de alta (no la entidad Certificado): la creación entera
    // vive en CertificadoService.CrearAsync.
    private CertificadoAltaVM? alta;
    private bool noEncontrada;
    private bool guardando;

    private int obraIdCargada;

    protected override async Task OnParametersSetAsync()
    {
        if (obraIdCargada == ObraId) return;
        obraIdCargada = ObraId;

        alta = await Service.BuildAltaVmAsync(ObraId);
        if (alta is null) { noEncontrada = true; return; }
        noEncontrada = false;

        if (alta.Estructuras.Count == 0)
        {
            Notifications.Notify(NotificationSeverity.Warning, "Sin estructuras",
                "Primero debe cargar al menos una estructura de costos para la obra.", 6000);
            Nav.NavigateTo($"obras/{ObraId}/certificados");
        }
    }

    private async Task GuardarAsync()
    {
        if (guardando || alta is null) return;
        guardando = true;
        try
        {
            // Patrón `rechazo`: las reglas de negocio del alta vuelven como mensaje (no
            // como excepción) y se notifican acá; Persistencia cubre el resto de fallos.
            var form = alta.Form;
            string? rechazo = null;
            int? creadoId = null;
            var hecho = await Persistencia.EjecutarAsync(async () =>
            {
                (creadoId, rechazo) = await Service.CrearAsync(ObraId, form);
            }, Notifications);

            if (rechazo is not null)
            {
                Notifications.Notify(NotificationSeverity.Error, "No se pudo crear", rechazo, 6000);
                return;
            }
            if (!hecho || creadoId is null) return;

            Notifications.Notify(NotificationSeverity.Success, "Certificado creado", $"N° {alta.Form.Numero}", 4000);
            Nav.NavigateTo($"certificados/{creadoId}/cargar");
        }
        finally { guardando = false; }
    }
}
