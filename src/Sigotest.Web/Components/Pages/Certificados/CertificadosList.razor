@page "/obras/{ObraId:int}/certificados"
@attribute [Authorize(Roles = Roles.Certificaciones)]
@inject CertificadoService Service
@inject NavigationManager Nav
@inject DialogService DialogService
@inject NotificationService Notifications

<PageTitle>@(obra is null ? "Certificados" : $"Certificados — {obra.Nombre}")</PageTitle>

@if (noEncontrada)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
        No se encontró la obra solicitada.
    </RadzenAlert>
}
else if (obra is null)
{
    <EstadoCargando Texto="Cargando certificados…" />
}
else
{
    <CabeceraPagina Titulo="Certificados de Avance" Clase="rz-mb-4"
                    Migas="@(new CabeceraPagina.Miga[] { new("Obras", "obras"), new(obra.Nombre, $"obras/{ObraId}"), new("Certificados") })">
        <Subtitulo>@obra.Nombre — @obra.NumeroLicitacion</Subtitulo>
        <Acciones>
            <RadzenButton Text="Nuevo Certificado" Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => Nav.NavigateTo($"obras/{ObraId}/certificados/nuevo"))" />
            <RadzenButton Text="Volver a Obra" Icon="arrow_back" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                          Variant="Variant.Flat" Click="@(() => Nav.NavigateTo($"obras/{ObraId}"))" />
        </Acciones>
    </CabeceraPagina>

    @if (certificados.Count == 0)
    {
        <EstadoVacio Icono="receipt_long" Titulo="No hay certificados para esta obra"
                     Descripcion="Los certificados registran el avance mensual contra una estructura de costos de la obra.">
            <Accion>
                <RadzenButton Text="Nuevo Certificado" Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                              Click="@(() => Nav.NavigateTo($"obras/{ObraId}/certificados/nuevo"))" />
            </Accion>
        </EstadoVacio>
    }
    else
    {
        <RadzenDataGrid Data="@certificados" TItem="CertificadoListItemVM" AllowFiltering="true" FilterMode="FilterMode.CheckBoxList"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowSorting="true" AllowPaging="true"
                        PageSize="20" Density="Density.Compact"
                        EmptyText="Ningún registro coincide con los filtros aplicados.">
            <Columns>
                <RadzenDataGridColumn TItem="CertificadoListItemVM" Property="Numero" Title="N°" Width="60px" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="CertificadoListItemVM" Title="Período" Width="150px" Filterable="false">
                    <Template Context="c">@Fmt.MesNombre(c.Mes) @c.Anio</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CertificadoListItemVM" Title="Bloques" Filterable="false" Sortable="false">
                    <Template Context="c">
                        <span class="app-muted">@c.Bloques</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CertificadoListItemVM" Property="Estado" Title="Estado" Width="120px" TextAlign="TextAlign.Center">
                    <Template Context="c">
                        <RadzenBadge Text="@c.Estado.ToString()" IsPill="true" BadgeStyle="@EstadoUi.Badge(c.Estado)" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CertificadoListItemVM" Property="FechaEmision" Title="Emisión" Width="110px"
                                      FormatString="{0:dd/MM/yyyy}" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="CertificadoListItemVM" Property="Observaciones" Title="Observaciones" />
                <RadzenDataGridColumn TItem="CertificadoListItemVM" Title="Acciones" Width="180px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                    <Template Context="c">
                        <RadzenButton Icon="visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info" Variant="Variant.Text"
                                      title="Ver" Click="@(() => Nav.NavigateTo($"certificados/{c.Id}"))" />
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text"
                                      title="Editar" Click="@(() => Nav.NavigateTo($"certificados/{c.Id}/cargar"))" />
                        <RadzenButton Icon="download" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Text"
                                      title="Excel" Click="@(() => Nav.NavigateTo($"/Certificado/DescargarExcel/{c.Id}", true))" />
                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                      title="@(c.EsCerrado ? "Un certificado cerrado no se puede eliminar (reabrilo primero)" : "Eliminar")"
                                      Disabled="@(procesando || c.EsCerrado)" Click="@(() => EliminarAsync(c))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
}

@code {
    [Parameter] public int ObraId { get; set; }

    private ObraResumenVM? obra;
    private List<CertificadoListItemVM> certificados = new();
    private bool noEncontrada;
    private bool procesando;

    private int obraIdCargada;

    protected override async Task OnParametersSetAsync()
    {
        if (obraIdCargada == ObraId) return;
        obraIdCargada = ObraId;

        obra = await Service.ObtenerObraAsync(ObraId);
        if (obra is null) { noEncontrada = true; return; }
        noEncontrada = false;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        certificados = await Service.ListarAsync(ObraId);
    }

    private async Task EliminarAsync(CertificadoListItemVM c)
    {
        if (procesando) return;
        // El flag antes del Confirm: un doble click no debe apilar dos diálogos.
        procesando = true;
        try
        {
            await UiAcciones.ConfirmarEliminarYRecargarAsync(DialogService, Notifications,
                $"¿Eliminar certificado N° {c.Numero}?",
                () => Service.EliminarAsync(c.Id),
                "Certificado eliminado", $"N° {c.Numero}",
                "Ya eliminado", $"El certificado N° {c.Numero} ya había sido eliminado por otro usuario.",
                CargarAsync);
        }
        finally { procesando = false; }
    }
}
