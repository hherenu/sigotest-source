@page "/certificados/{Id:int}/cargar"
@attribute [Authorize(Roles = Roles.Certificaciones)]
@inject CertificadoService Service
@inject NavigationManager Nav
@inject DialogService DialogService
@inject NotificationService Notifications

<PageTitle>@(vm is null ? "Carga de certificado" : $"Certificado N° {vm.Numero} — Carga")</PageTitle>

@if (noEncontrado)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
        No se encontró el certificado solicitado.
    </RadzenAlert>
}
else if (vm is null)
{
    <EstadoCargando Texto="Cargando certificado…" />
}
else
{
    var cambios = CargaCertificado.CambiosSinGuardar(vm, pct);
    <GuardNavegacion HayCambios="@HayCambiosSinGuardar" />

    <CabeceraPagina Titulo="@($"Certificado N° {vm.Numero} — {Fmt.MesNombre(vm.Mes)} {vm.Anio}")" Clase="rz-mb-2"
                    Migas="@(new CabeceraPagina.Miga[] { new("Obras", "obras"), new(vm.ObraNombre, $"obras/{vm.ObraId}"), new("Certificados", $"obras/{vm.ObraId}/certificados"), new($"N° {vm.Numero} — Carga") })">
        <Badges>
            <RadzenBadge Text="Borrador" IsPill="true" BadgeStyle="BadgeStyle.Secondary" />
        </Badges>
        <Subtitulo>@vm.ObraNombre</Subtitulo>
        <Acciones>
            @* Guardar también en la cabecera (además del pie): con estructuras largas
               el botón del pie queda a varias pantallas de scroll. Mismo criterio que
               ya aplicaba Planificación, también para el contador de cambios. *@
            @if (cambios > 0)
            {
                <RadzenText TextStyle="TextStyle.Caption" class="app-muted rz-mb-0">@TextoCambios(cambios)</RadzenText>
            }
            <RadzenButton Text="Guardar certificado" Icon="save" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                          IsBusy="@procesando" BusyText="Guardando..." Click="@GuardarAsync" />
            <RadzenButton Text="Importar % desde Excel" Icon="upload" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary"
                          Variant="Variant.Flat" Disabled="@procesando" Click="@ImportarExcelAsync" />
            <RadzenButton Text="Ver Detalle" Icon="visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                          Variant="Variant.Flat" Click="@(() => Nav.NavigateTo($"certificados/{Id}"))" />
            <RadzenButton Text="Volver a Certificados" Icon="arrow_back" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                          Variant="Variant.Flat" Click="@(() => Nav.NavigateTo($"obras/{vm.ObraId}/certificados"))" />
        </Acciones>
    </CabeceraPagina>

    <RadzenText TextStyle="TextStyle.Body2" class="app-muted rz-mb-3">
        Ingresá el <b>% del mes</b> por ítem. Se admiten valores negativos (BED, economías, descertificaciones).
    </RadzenText>

    @* ── Agregar bloque ── *@
    @if (disponibles.Count > 0)
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.5rem" class="rz-mb-3" style="max-width:620px">
            <RadzenFormField Text="Agregar bloque (estructura)" Variant="Variant.Outlined" style="flex:1">
                <RadzenDropDown @bind-Value="nuevoBloqueEstructuraId" Data="@disponibles" TextProperty="Nombre" ValueProperty="Id"
                                TValue="int?" style="width:100%" />
            </RadzenFormField>
            <RadzenButton Text="Agregar bloque" Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                          Variant="Variant.Flat" Disabled="@procesando" Click="@AgregarBloqueAsync" />
        </RadzenStack>
    }

    @foreach (var bloque in vm.Bloques.OrderBy(b => b.Orden))
    {
        @* @key: sin esto, al quitar un bloque Blazor puede reutilizar los inputs del bloque equivocado. *@
        <RadzenCard @key="bloque.CertificadoEstructuraId" Variant="Variant.Outlined" class="rz-mb-3">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                         AlignItems="AlignItems.Center" class="rz-mb-2">
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0" style="font-weight:600">@bloque.Titulo</RadzenText>
                @if (vm.Bloques.Count > 1)
                {
                    <RadzenButton Text="Quitar bloque" Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                  Variant="Variant.Text" Disabled="@procesando" Click="@(() => EliminarBloqueAsync(bloque))" />
                }
            </RadzenStack>
            @* Descripción ajustable: por defecto ocupa el ancho libre y corta el texto con «…»
               (completo en el title), así el ítem y su % del mes se ven sin scroll horizontal;
               el asa del encabezado cambia el ancho (CSS en app-blazor.css, JS en App.razor). *@
            <div class="cert-scroll">
                <table class="cert-grid cert-grid-ajustable">
                    <caption class="sr-only">Carga del % de avance del mes — @bloque.Titulo</caption>
                    <thead>
                        <tr>
                            <th scope="col">Cód.</th>
                            <th scope="col" class="cert-col-desc">Descripción<AsaAnchoDescripcion /></th>
                            <th scope="col" class="centro">Unid.</th>
                            <th scope="col" class="num">Cant. Contrato</th>
                            <th scope="col" class="num">PU Básico</th>
                            <th scope="col" class="num">Monto Contrato</th>
                            <th scope="col" class="num col-warning">% Anterior</th>
                            <th scope="col" class="num col-warning">Monto Anterior</th>
                            <th scope="col" class="num col-primary">% Mes</th>
                            <th scope="col" class="num col-primary">Monto Mes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (item, nivel) in filasPorBloque[bloque.CertificadoEstructuraId])
                        {
                            @* Sangría en la Descripción, para rubros e ítems por igual: antes el ítem
                               sangraba el Código y su Descripción quedaba a la izquierda de su rubro. *@
                            var sangria = $"padding-left:{FilaEstructuraUi.Sangria(nivel)}px";
                            if (item.EsAgrupador)
                            {
                                <tr @key="item.ItemEstructuraId" class="@(nivel == 0 ? "agrup-0" : "agrup-1")">
                                    <td></td>
                                    <td class="cert-col-desc" style="@sangria" title="@item.Descripcion">@item.Descripcion</td>
                                    <td></td><td></td><td></td>
                                    <td class="num">@Fmt.Money(item.MontoContrato ?? 0)</td>
                                    <td class="col-warning"></td>
                                    <td class="num col-warning">@Fmt.Money(item.MontoAnterior)</td>
                                    <td class="col-primary"></td>
                                    <td class="num col-primary">@Fmt.Money(item.MontoMes)</td>
                                </tr>
                            }
                            else
                            {
                                <tr @key="item.ItemEstructuraId">
                                    <td class="cell-mono">@item.Codigo</td>
                                    <td class="cert-col-desc" style="@sangria" title="@item.Descripcion">@item.Descripcion</td>
                                    <td class="centro">@item.Unidad</td>
                                    <td class="num">@(item.CantidadContrato is decimal cc ? Fmt.HastaN4(cc) : "")</td>
                                    <td class="num">@(item.PUBasico is decimal pu ? "$ " + Fmt.HastaN4(pu) : "")</td>
                                    <td class="num">@(item.MontoContrato is decimal mc ? "$ " + Fmt.N2(mc) : "")</td>
                                    <td class="num col-warning">@(item.PorcentajeAnterior is decimal pa ? Fmt.N2(pa) + "%" : "")</td>
                                    <td class="num col-warning">@Fmt.Money(item.MontoAnterior)</td>
                                    <td class="col-primary" style="@(ExcedeAcumulado(bloque.CertificadoEstructuraId, item) ? "outline:2px solid var(--rz-danger);outline-offset:-2px" : "")"
                                        title="@(ExcedeAcumulado(bloque.CertificadoEstructuraId, item) ? $"El acumulado (anterior {Fmt.N2(item.PorcentajeAnterior ?? 0)}% + mes) supera el 100%" : null)">
                                        @* aria-label: sin él, un lector de pantalla anuncia el input sin
                                           decir de qué ítem es (Radzen lo propaga al <input>). *@
                                        <RadzenNumeric TValue="decimal?" @bind-Value="pct[bloque.CertificadoEstructuraId][item.ItemEstructuraId]"
                                                       Step="0.01" ShowUpDown="false" TextAlign="TextAlign.Right" style="width:110px"
                                                       aria-label="@($"% del mes — {item.Codigo} {item.Descripcion}")" />
                                    </td>
                                    <td class="num col-primary">@Fmt.Money(LiveMonto(bloque.CertificadoEstructuraId, item))</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="5" class="num">Subtotal @bloque.Titulo</td>
                            <td class="num">$ @Fmt.N2(bloque.TotalMontoContrato)</td>
                            <td colspan="2" class="num">$ @Fmt.N2(bloque.TotalMontoAnterior)</td>
                            <td colspan="2" class="num">$ @Fmt.N2(bloque.TotalMontoMes)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </RadzenCard>
    }

    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
        <RadzenButton Text="Guardar certificado" Icon="save" ButtonStyle="ButtonStyle.Primary"
                      IsBusy="@procesando" BusyText="Guardando..." Click="@GuardarAsync" />
        <RadzenButton Text="Cancelar" Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                      Click="@(() => Nav.NavigateTo($"obras/{vm.ObraId}/certificados"))" />
        @if (cambios > 0)
        {
            <RadzenText TextStyle="TextStyle.Caption" class="app-muted rz-mb-0">@TextoCambios(cambios)</RadzenText>
        }
    </RadzenStack>
}

@code {
    [Parameter] public int Id { get; set; }

    private CertificadoVM? vm;
    private bool noEncontrado;

    // bloqueId (CertificadoEstructuraId) → itemEstructuraId → % del mes
    private Dictionary<int, Dictionary<int, decimal?>> pct = new();
    // bloqueId → árbol aplanado (se calcula una vez por carga, no por render)
    private Dictionary<int, List<(ItemCertificadoVM Item, int Nivel)>> filasPorBloque = new();
    private List<EstructuraOpcionVM> disponibles = new();
    private int? nuevoBloqueEstructuraId;
    private bool procesando;
    private bool importando;

    private int idCargado;

    protected override async Task OnParametersSetAsync()
    {
        if (idCargado == Id) return;
        idCargado = Id;

        await BuildStateAsync();
        if (noEncontrado) return;

        if (vm is not null && !vm.EsEditable)
        {
            Notifications.Notify(NotificationSeverity.Info, "No editable",
                "El certificado no está en borrador. Reabrilo para editarlo.", 5000);
            Nav.NavigateTo($"certificados/{Id}");
        }
    }

    /// <param name="conservarTipeado">
    /// false solo tras un guardado exitoso: lo guardado ya es lo tipeado y todo sale de la base.
    /// </param>
    private async Task BuildStateAsync(bool conservarTipeado = true)
    {
        // El VM se reconstruye completo (incluido su RowVersion): agregar/quitar bloque
        // actualiza la fila del certificado, y el token de sesión que viaja al guardado
        // debe ser el último visto.
        var anterior = vm;
        vm = await Service.BuildVmAsync(Id);
        if (vm is null) { noEncontrado = true; return; }
        noEncontrado = false;

        // Agregar/quitar un bloque o un guardado fallido reconstruyen el estado desde la DB:
        // se preserva solo lo que el usuario tipeó (sin esto se perdía); el resto toma lo
        // recién leído, que puede incluir lo que otro usuario guardó en el medio (ver
        // CargaCertificado).
        pct = conservarTipeado ? CargaCertificado.Porcentajes(vm, anterior, pct) : CargaCertificado.Porcentajes(vm);

        // El árbol se aplana UNA vez acá, no en cada render: al tipear un % el
        // componente se re-renderiza y volvería a aplanar todos los bloques.
        filasPorBloque = vm.Bloques.ToDictionary(
            b => b.CertificadoEstructuraId,
            b => Arbol.Aplanar(b.Items, i => i.AgrupadorPadreId, i => i.ItemEstructuraId, i => i.Orden, i => i.EsAgrupador));

        var usadas = vm.Bloques.Select(b => b.EstructuraCostosId).ToHashSet();
        disponibles = await Service.EstructurasDisponiblesAsync(vm.ObraId, usadas);
        nuevoBloqueEstructuraId = disponibles.FirstOrDefault()?.Id;
    }

    // true si algún % tipeado difiere de lo guardado en la DB. Tras guardar el VM se
    // relee, así que la comparación vuelve a dar sin cambios sin ningún flag aparte.
    private bool HayCambiosSinGuardar() => vm is not null && CargaCertificado.CambiosSinGuardar(vm, pct) > 0;

    private static string TextoCambios(int cambios) =>
        cambios == 1 ? "1 cambio sin guardar" : $"{cambios} cambios sin guardar";

    private decimal LiveMonto(int bloqueId, ItemCertificadoVM item)
    {
        var p = pct[bloqueId][item.ItemEstructuraId] ?? 0;
        // Misma implementación que usa GuardarItemsAsync: lo que se muestra en vivo
        // es exactamente lo que se guarda (antes eran dos copias de la fórmula).
        return CertificadoService.MovimientoDeMes(item.CantidadContrato, item.PUBasico, item.MontoContrato, p).Monto;
    }

    private async Task AgregarBloqueAsync()
    {
        if (procesando || nuevoBloqueEstructuraId is not int estId) return;

        procesando = true;
        try
        {
            // La persistencia vive en el servicio; la página solo traduce el resultado
            // a notificaciones. Si el certificado ya no existe (Encontrado=false) no se
            // notifica: BuildStateAsync lo detecta como "no encontrado".
            CertificadoService.ResultadoBloque? res = null;
            var hecho = await Persistencia.EjecutarAsync(
                async () => res = await Service.AgregarBloqueAsync(Id, estId), Notifications);

            if (hecho && res is not null)
            {
                if (res.Rechazo is RechazoBloque rechazo)
                    NotificarRechazoBloque(rechazo);
                else if (res.Encontrado)
                    Notifications.Notify(NotificationSeverity.Success, "Bloque agregado",
                        disponibles.FirstOrDefault(e => e.Id == estId)?.Nombre ?? "", 3000);
            }
            await BuildStateAsync();
        }
        finally { procesando = false; }
    }

    private async Task EliminarBloqueAsync(BloqueCertificadoVM bloque)
    {
        if (procesando) return;
        // El flag antes del Confirm: un doble click no debe apilar dos diálogos.
        procesando = true;
        try
        {
            // El bloque se borra en el momento (no espera a «Guardar certificado»): el
            // mensaje lo dice, porque el resto de la pantalla sí espera al guardado.
            var ok = await DialogService.Confirm(
                $"Se quita el bloque «{bloque.Titulo}» ahora mismo, con los % del mes que tenía guardados, " +
                "y no se puede deshacer. Lo que tipeaste en los demás bloques se conserva.",
                "Quitar bloque",
                new ConfirmOptions { OkButtonText = "Quitar bloque", CancelButtonText = "Cancelar" });
            if (ok != true) return;

            CertificadoService.ResultadoBloque? res = null;
            var hecho = await Persistencia.EjecutarAsync(
                async () => res = await Service.QuitarBloqueAsync(bloque.CertificadoEstructuraId), Notifications);

            if (hecho && res is not null)
            {
                if (res.Rechazo is RechazoBloque rechazo)
                    NotificarRechazoBloque(rechazo);
                else if (res.Encontrado)
                    Notifications.Notify(NotificationSeverity.Success, "Bloque quitado", bloque.Titulo, 3000);
            }
            await BuildStateAsync();
        }
        finally { procesando = false; }
    }

    // Título y severidad según el motivo; motivo y mensaje vienen juntos de CertificadoValidator.
    private void NotificarRechazoBloque(RechazoBloque rechazo)
    {
        var (severidad, titulo) = rechazo.Motivo switch
        {
            MotivoRechazoBloque.Duplicado => (NotificationSeverity.Warning, "Duplicado"),
            MotivoRechazoBloque.EstructuraInvalida => (NotificationSeverity.Error, "Inválida"),
            _ => (NotificationSeverity.Warning, "No editable")
        };
        Notifications.Notify(severidad, titulo, rechazo.Mensaje, 5000);
    }

    /// <summary>
    /// Abre el diálogo de importación y vuelca en <c>pct</c> los % que devuelve, bloque
    /// por bloque. Solo se tocan los ítems con renglón en la planilla; el resto conserva
    /// lo tipeado. No se guarda: el usuario revisa la grilla y recién entonces guarda,
    /// con el mismo chequeo de acumulado y token de concurrencia de siempre.
    /// </summary>
    private async Task ImportarExcelAsync()
    {
        if (procesando || importando || vm is null) return;

        // Flag propio y no `procesando` (que pondría «Guardando...» en los botones Guardar
        // mientras el diálogo está abierto), puesto ANTES de abrir: un doble clic no debe
        // apilar dos diálogos de importación.
        importando = true;
        object? resultado;
        try
        {
            resultado = await DialogService.OpenAsync<CertificadoImportarDialog>(
                "Importar % del mes desde Excel",
                new Dictionary<string, object?> { [nameof(CertificadoImportarDialog.Vm)] = vm },
                new DialogOptions { Width = "min(1100px, 92vw)" });
        }
        finally { importando = false; }
        if (resultado is not List<AplicacionBloque> aplicaciones) return;

        var volcados = 0;
        foreach (var ap in aplicaciones)
        {
            if (!pct.TryGetValue(ap.CertificadoEstructuraId, out var porItem)) continue;
            foreach (var (itemId, p) in ap.Porcentajes)
            {
                if (!porItem.ContainsKey(itemId)) continue;
                porItem[itemId] = p == 0 ? null : p;
                volcados++;
            }
        }
        Notifications.Notify(NotificationSeverity.Success, "Porcentajes volcados",
            $"{volcados} ítems actualizados en la grilla. Revisá y presioná «Guardar certificado».", 4000);
    }

    // La regla (umbral y epsilon) vive en CertificadoValidator; acá solo se resuelve
    // el % tipeado en la sesión para el ítem.
    private bool ExcedeAcumulado(int bloqueId, ItemCertificadoVM item) =>
        !item.EsAgrupador && CertificadoValidator.ExcedeAvanceAcumulado(
            item.PorcentajeAnterior, pct[bloqueId].GetValueOrDefault(item.ItemEstructuraId) ?? 0);

    private async Task GuardarAsync()
    {
        if (procesando) return;
        procesando = true;
        try
        {
            var excedidos = vm!.Bloques
                .Sum(b => b.Items.Count(i => ExcedeAcumulado(b.CertificadoEstructuraId, i)));
            if (excedidos > 0)
            {
                var ok = await DialogService.Confirm(
                    $"{excedidos} ítem(s) superan el 100% de avance acumulado (anterior + mes). ¿Guardar igual?",
                    "Avance mayor al 100%",
                    new ConfirmOptions { OkButtonText = "Guardar igual", CancelButtonText = "Revisar" });
                if (ok != true) return;
            }

            var porBloque = pct.ToDictionary(
                kv => kv.Key,
                kv => kv.Value.ToDictionary(x => x.Key, x => x.Value ?? 0m));

            var hecho = await Persistencia.EjecutarAsync(
                () => Service.GuardarItemsAsync(Id, porBloque, vm!.RowVersion), Notifications,
                conflicto: "Otro usuario guardó este certificado mientras cargabas. Se trajeron sus cambios y " +
                           "se conservó lo que tipeaste: revisalo y volvé a guardar.");

            // Se queda en la carga: antes iba al detalle y no se podía guardar de a poco (cada
            // guardado obligaba a volver con «Editar» y buscar dónde estaba). Se relee siempre:
            // tras un fallo, conservando lo tipeado y con el token al día, así un conflicto ya
            // no obliga a recargar la página, que borraba todo lo cargado.
            await Persistencia.EjecutarAsync(() => BuildStateAsync(conservarTipeado: !hecho), Notifications);
            if (hecho)
                Notifications.Notify(NotificationSeverity.Success, "Guardado",
                    "Certificado guardado. Podés seguir cargando; «Ver Detalle» muestra el certificado completo.", 4000);
        }
        finally { procesando = false; }
    }
}
