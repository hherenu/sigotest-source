@page "/obras/{ObraId:int}/estructuras"
@attribute [Authorize(Roles = Roles.Certificaciones)]
@inject EstructuraService Estructuras
@inject NavigationManager Nav
@inject RetornoObra Retorno
@inject DialogService DialogService
@inject NotificationService Notifications

<PageTitle>@(obra is null ? "Estructuras de Costos" : $"Estructuras — {obra.Nombre}")</PageTitle>

@if (noEncontrada)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
        No se encontró la obra solicitada.
    </RadzenAlert>
}
else if (obra is null || estructuras is null)
{
    <EstadoCargando Texto="Cargando estructuras…" />
}
else
{
    <CabeceraPagina Titulo="Estructuras de Costos"
                    Migas="@(new CabeceraPagina.Miga[] { new("Obras", "obras"), new(obra.Nombre, $"obras/{ObraId}"), new("Estructuras") })">
        <Subtitulo>@obra.Nombre — @obra.NumeroLicitacion</Subtitulo>
        <Acciones>
            <RadzenButton Text="Nueva Estructura" Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => Nav.NavigateTo($"obras/{ObraId}/estructuras/nueva"))" />
            @* Vuelve a donde se entró: la ficha o el listado de Obras (RetornoObra). *@
            <RadzenButton Text="@Retorno.Volver(ObraId).Texto" Icon="arrow_back" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                          Variant="Variant.Flat" Click="@(() => Nav.NavigateTo(Retorno.Volver(ObraId).Ruta))" />
        </Acciones>
    </CabeceraPagina>

    @if (estructuras.Count == 0)
    {
        <EstadoVacio Icono="account_tree" Titulo="No hay estructuras de costos para esta obra"
                     Descripcion="La estructura define los ítems del contrato (códigos, cantidades y precios) y es la base de los certificados de avance.">
            <Accion>
                <RadzenButton Text="Nueva Estructura" Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                              Click="@(() => Nav.NavigateTo($"obras/{ObraId}/estructuras/nueva"))" />
            </Accion>
        </EstadoVacio>
    }
    else
    {
        <RadzenRow Gap="1rem" RowGap="1rem">
            @foreach (var est in estructuras)
            {
                <RadzenColumn @key="est.Id" Size="12" SizeMD="6">
                    <RadzenCard Variant="Variant.Outlined">
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                                     AlignItems="AlignItems.Center" class="rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0 app-titulo-bloque">@est.Nombre</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" class="app-muted rz-mb-0">
                                Creada: @est.FechaCreacion.ToString("dd/MM/yyyy")
                            </RadzenText>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-1"><b>Ítems:</b> @est.TotalItems</RadzenText>
                        @if (est.MontoTotal > 0)
                        {
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0"><b>Monto Total:</b> $ @Fmt.N2(est.MontoTotal)</RadzenText>
                        }
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-3">
                            <RadzenButton Text="Ver / Editar Ítems" Icon="list_alt" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                          Click="@(() => Nav.NavigateTo($"estructuras/{est.Id}"))" />
                            <RadzenButton Text="Eliminar" Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                          Variant="Variant.Flat" Disabled="@procesando" Click="@(() => EliminarAsync(est))" />
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
            }
        </RadzenRow>
    }
}

@code {
    [Parameter] public int ObraId { get; set; }

    private ObraResumenVM? obra;
    // null = cargando, como pide convenciones-ui (con new(), un render durante la carga mostraría «no hay estructuras»).
    private List<EstructuraVM>? estructuras;
    private bool noEncontrada;
    private bool procesando;

    private int obraIdCargada;

    protected override async Task OnParametersSetAsync()
    {
        if (obraIdCargada == ObraId) return;
        obraIdCargada = ObraId;

        obra = await Estructuras.ObtenerObraAsync(ObraId);
        if (obra is null) { noEncontrada = true; return; }
        noEncontrada = false;
        await CargarAsync();
    }

    private async Task CargarAsync() =>
        estructuras = await Estructuras.ListarAsync(ObraId);

    private async Task EliminarAsync(EstructuraVM est)
    {
        if (procesando) return;
        // El flag antes del Confirm: un doble click no debe apilar dos diálogos.
        procesando = true;
        try
        {
            // El RowVersion de la card viaja al DELETE como token de concurrencia.
            await UiAcciones.ConfirmarEliminarYRecargarAsync(DialogService, Notifications,
                $"¿Eliminar estructura «{est.Nombre}»? Se eliminarán todos sus ítems.",
                () => Estructuras.EliminarAsync(est.Id, est.RowVersion),
                "Estructura eliminada", est.Nombre,
                "Ya eliminada", $"La estructura «{est.Nombre}» ya había sido eliminada por otro usuario.",
                CargarAsync);
        }
        finally { procesando = false; }
    }
}
