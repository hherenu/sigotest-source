@page "/planificacion"
@attribute [Authorize(Roles = Roles.Planificacion)]
@inject PlanificacionService Service
@inject NavigationManager Nav
@inject EstadoGrillas Grillas

<PageTitle>Planificación</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
             AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap" Gap="0.5rem" class="rz-mb-4">
    <RadzenStack Gap="0.15rem">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-0">Planificación de Obras</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption" class="app-muted rz-mb-0">Curva de inversión prevista por obra</RadzenText>
    </RadzenStack>
    @* Dropdown pelado (sin FormField ni label): el recuadro con etiqueta flotante
       era mucho más alto que los botones chicos y desbalanceaba la fila. *@
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
        @if (obras is { Count: > 0 })
        {
            <FiltrosGrilla Vista="@vista" Placeholder="Buscar obra, licitación o director…" />
        }
        <RadzenDropDown Name="ddCorte" TValue="CorteOption" Data="@cortes" TextProperty="Texto" @bind-Value="@corteSel"
                        Change="@(async _ => await CargarCorteAsync())" style="min-width:170px"
                        title="Versión del plan a mostrar" aria-label="Versión del plan a mostrar" />
        <RadzenButton Text="Exportar Excel" Icon="download" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Flat"
                      Click="@(() => Exportar(corteSel.EsVigente ? "vigente" : "corte"))" />
        <RadzenButton Text="Historial completo" Icon="history" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Text"
                      Click="@(() => Exportar("versiones"))" title="Todas las versiones mensuales (equivalente al export completo de Flokzu)" />
    </RadzenStack>
</RadzenStack>

@if (obras is null)
{
    <EstadoCargando Texto="Cargando planificación…" />
}
else if (obras.Count == 0)
{
    <EstadoVacio Icono="event_note"
                 Titulo="@(soloDirector ? "No tenés obras asignadas como director" : "No hay obras cargadas")"
                 Descripcion="@DescripcionVacio" />
}
else
{
    <GrillaListado Vista="@vista">
        <RadzenDataGridColumn TItem="PlanObraRowVM" Property="Nombre" Title="Obra" Width="260px" />
        <RadzenDataGridColumn TItem="PlanObraRowVM" Property="NumeroLicitacion" Title="Licitación" Width="140px" />
        <RadzenDataGridColumn TItem="PlanObraRowVM" Property="DirectorObra" Title="Director" Width="180px" />
        @* Las columnas calculadas muestran una propiedad de texto del VM: es también lo
           que ofrece su filtro. *@
        @if (corteSel.EsVigente)
        {
            <RadzenDataGridColumn TItem="PlanObraRowVM" Property="EstadoPlanTexto" Title="Estado del plan" Width="150px" TextAlign="TextAlign.Center" Sortable="false">
                <Template Context="obra">
                    <RadzenBadge Text="@obra.EstadoPlanTexto" IsPill="true"
                                 BadgeStyle="@(obra.EstadoPlan is EstadoPlanificacion e ? EstadoUi.Badge(e) : BadgeStyle.Dark)" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PlanObraRowVM" Property="CicloDelMes" Title="Ciclo del mes" Width="170px" TextAlign="TextAlign.Center" Sortable="false">
                <Template Context="obra">
                    @if (obra.CicloDelMes == PlanObraRowVM.SinCiclo)
                    {
                        <span class="app-muted">@obra.CicloDelMes</span>
                    }
                    else if (obra.ObraFinalizada)
                    {
                        <RadzenBadge Text="@obra.CicloDelMes" IsPill="true" BadgeStyle="BadgeStyle.Dark" />
                    }
                    else
                    {
                        <RadzenBadge Text="@obra.CicloDelMes" IsPill="true" Shade="Shade.Lighter"
                                     BadgeStyle="@(obra.FechaTomaConocimiento is null ? BadgeStyle.Warning : BadgeStyle.Success)" />
                    }
                </Template>
            </RadzenDataGridColumn>
        }
        else
        {
            <RadzenDataGridColumn TItem="PlanObraRowVM" Property="VersionAlCorte" Title="@($"Versión al corte ({corteSel.Texto})")" Width="220px" TextAlign="TextAlign.Center" Sortable="false">
                <Template Context="obra">
                    <RadzenBadge Text="@obra.VersionAlCorte" IsPill="true"
                                 BadgeStyle="@(versionesCorte.ContainsKey(obra.Id) ? BadgeStyle.Info : BadgeStyle.Dark)"
                                 Shade="@(versionesCorte.ContainsKey(obra.Id) ? Shade.Lighter : Shade.Default)" />
                </Template>
            </RadzenDataGridColumn>
        }
        <RadzenDataGridColumn TItem="PlanObraRowVM" Title="Acciones" Width="130px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false">
            <Template Context="obra">
                <RadzenButton Text="Planificar" Icon="event_note" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text"
                              Click="@(() => Nav.NavigateTo($"planificacion/{obra.Id}/editar"))" />
            </Template>
        </RadzenDataGridColumn>
    </GrillaListado>
}

@code {
    private List<PlanObraRowVM>? obras;
    private VistaGrilla<PlanObraRowVM> vista = null!;
    private bool soloDirector;

    private string DescripcionVacio => soloDirector
        ? "Un administrador debe asignarte como director desde la ficha de cada obra."
        : "Cuando haya obras cargadas, sus curvas de inversión se planifican desde acá.";

    /// <summary>Opción del selector: el plan vivo ("Vigente") o un corte mensual (as-of por snapshots).</summary>
    private sealed record CorteOption(int? Anio, int? Mes, string Texto)
    {
        public bool EsVigente => Anio is null;
    }
    private List<CorteOption> cortes = [new(null, null, "Vigente")];
    private CorteOption corteSel = new(null, null, "Vigente");

    private Dictionary<int, VersionCorteVM> versionesCorte = new();

    protected override async Task OnInitializedAsync()
    {
        vista = new(Grillas.De("planificacion"), o => [o.Nombre, o.NumeroLicitacion, o.DirectorObra]);
        // El servicio aplica el alcance (un director sin rol de alcance total ve solo
        // sus obras asignadas) y trae el estado del plan de cada obra listada.
        var listado = await Service.ListadoAsync();
        soloDirector = listado.SoloDirector;
        obras = listado.Obras;
        vista.Cargar(obras);
        cortes = [new(null, null, "Vigente"), .. listado.Cortes.Select(m => new CorteOption(m.Anio, m.Mes, $"{Fmt.MesCorto(m.Mes)} {m.Anio}"))];
    }

    private async Task CargarCorteAsync()
    {
        if (corteSel.EsVigente || obras is null) { versionesCorte = new(); return; }

        // As-of: la última versión de cada obra hasta el corte inclusive.
        versionesCorte = await Service.VersionesAlCorteAsync(
            obras.Select(o => o.Id).ToList(), corteSel.Anio!.Value, corteSel.Mes!.Value);

        // Texto de la columna y de su filtro: depende del corte, no de la obra.
        foreach (var o in obras)
            o.VersionAlCorte = PlanObraRowVM.TextoVersionAlCorte(versionesCorte.GetValueOrDefault(o.Id));
        // Los textos cambiaron en el lugar (la Data es la misma): las opciones del filtro
        // se recalculan y la grilla vuelve a aplicar los filtros sobre los textos nuevos.
        vista.RefrescarOpcionesDeFiltro();
        if (vista.Grid is not null) await vista.Grid.Reload();
    }

    /// <summary>
    /// Descarga el Excel respetando lo que muestra la grilla: la búsqueda y los filtros
    /// aplicados (View) y el corte elegido. "versiones" exporta todas las fotos mensuales.
    /// </summary>
    private void Exportar(string modo)
    {
        var visibles = vista.Grid?.View?.Select(o => o.Id).ToList() ?? obras?.Select(o => o.Id).ToList() ?? [];
        var url = $"PlanificacionExport/General?modo={modo}&obras={string.Join(",", visibles)}";
        if (modo == "corte" && !corteSel.EsVigente)
            url += $"&anio={corteSel.Anio}&mes={corteSel.Mes}";
        Nav.NavigateTo(url, forceLoad: true);
    }
}
