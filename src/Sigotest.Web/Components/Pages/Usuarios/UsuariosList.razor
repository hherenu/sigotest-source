@page "/usuarios"
@attribute [Authorize(Roles = Roles.Admin)]
@inject UsuarioService Service
@inject DialogService DialogService
@inject NotificationService Notifications
@inject EstadoGrillas Grillas

<PageTitle>Usuarios</PageTitle>

<CabeceraPagina Titulo="Usuarios" Estilo="TextStyle.H4" Clase="rz-mb-4">
    <Subtitulo>
        La autenticación es Windows y <b>no hay alta manual</b>: quien entra por primera vez se registra solo,
        <b>sin ningún rol</b> (no puede hacer nada hasta que un Admin le tilde roles acá). Un usuario sin roles o inactivo no accede a ningún módulo.
    </Subtitulo>
    <Acciones>
        @if (usuarios is { Count: > 0 })
        {
            <FiltrosGrilla Vista="@vista" Placeholder="Buscar usuario, nombre o email…" />
        }
    </Acciones>
</CabeceraPagina>

@if (usuarios is null)
{
    <EstadoCargando Texto="Cargando usuarios…" />
}
else if (usuarios.Count == 0)
{
    <EstadoVacio Icono="group" Titulo="Todavía no hay usuarios registrados"
                 Descripcion="Cada persona queda registrada automáticamente en su primer ingreso (la primera de todas, como Admin)." />
}
else
{
    @* Grilla directa al contenido (sin tarjeta): entra en la cadena de altura del
       layout — ocupa el alto restante con scroll interno y encabezado fijo. La
       edición abre en diálogo (el registro es automático al primer ingreso,
       acá no se crean usuarios). *@
    <GrillaListado Vista="@vista">
        <RadzenDataGridColumn TItem="UsuarioVM" Property="WindowsUser" Title="Usuario Windows" Width="180px" />
        <RadzenDataGridColumn TItem="UsuarioVM" Property="Nombre" Title="Nombre" Width="200px" />
        <RadzenDataGridColumn TItem="UsuarioVM" Property="Email" Title="Email" Width="220px" />
        @* El filtro ofrece las combinaciones de roles tal como se ven («Admin, Gerente»):
           tildar «Admin» no incluye «Admin, Gerente»; su buscador encuentra todas las que
           tienen un rol. *@
        <RadzenDataGridColumn TItem="UsuarioVM" Property="RolesTexto" Title="Roles" Width="200px" Sortable="false">
            <Template Context="u">
                @if (!u.Roles.Any())
                {
                    <span class="app-muted">@UsuarioVM.SinRoles</span>
                }
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" Wrap="FlexWrap.Wrap">
                    @foreach (var r in u.Roles.OrderBy(x => x))
                    {
                        <RadzenBadge Text="@r.ToString()" IsPill="true"
                                     BadgeStyle="@(r == RolUsuario.Admin ? BadgeStyle.Danger : BadgeStyle.Info)" />
                    }
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
        @* Property es el texto y no el bool: con un FilterProperty distinto, Radzen toma
           Property como colección (SelectMany) y el filtro rompía la página. *@
        <RadzenDataGridColumn TItem="UsuarioVM" Property="ActivoTexto" SortProperty="Activo" Title="Activo" Width="80px" TextAlign="TextAlign.Center">
            <Template Context="u">
                <RadzenIcon Icon="@(u.Activo ? "check_circle" : "cancel")"
                            IconColor="@(u.Activo ? "var(--rz-success)" : "var(--rz-danger)")"
                            title="@(u.Activo ? "Activo" : "Inactivo")" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="UsuarioVM" Title="" Width="100px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
            <Template Context="u">
                @* editar=Primary y eliminar=delete, como todas las filas de la app
                   (eran Warning y close, únicos acá). *@
                <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text"
                              title="Editar" Disabled="@procesando" Click="@(() => EditarAsync(u))" />
                <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                              title="Eliminar" Disabled="@procesando" Click="@(() => EliminarAsync(u))" />
            </Template>
        </RadzenDataGridColumn>
    </GrillaListado>
}

@code {
    // Nullable: null = cargando. Inicializarla en new() mostraba el estado vacío
    // ("Todavía no hay usuarios registrados") durante toda la carga.
    private List<UsuarioVM>? usuarios;
    private VistaGrilla<UsuarioVM> vista = null!;
    private bool procesando;

    protected override async Task OnInitializedAsync()
    {
        vista = new(Grillas.De("usuarios"), u => [u.WindowsUser, u.Nombre, u.Email]);
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        usuarios = await Service.ListarAsync();
        vista.Cargar(usuarios);
    }

    private async Task EditarAsync(UsuarioVM u)
    {
        if (procesando) return;

        // Copia editable: el diálogo no bindea la fila de la grilla; el RowVersion de
        // la fila listada acompaña como token del UPDATE.
        var copia = new UsuarioVM
        {
            Id = u.Id,
            WindowsUser = u.WindowsUser,
            Nombre = u.Nombre,
            Email = u.Email,
            Activo = u.Activo,
            Roles = u.Roles.ToList(),
            RowVersion = u.RowVersion
        };

        // El flag antes del diálogo: un doble clic no debe apilar dos diálogos.
        procesando = true;
        try
        {
            var resultado = await DialogService.OpenAsync<UsuarioEditarDialog>(
                $"Editar — {u.WindowsUser}",
                new Dictionary<string, object?> { [nameof(UsuarioEditarDialog.Usuario)] = copia },
                new DialogOptions { Width = "min(480px, 92vw)" });

            if (resultado is true)
                await CargarAsync();
        }
        finally { procesando = false; }
    }

    private async Task EliminarAsync(UsuarioVM u)
    {
        if (procesando) return;
        // El flag antes del Confirm: un doble click no debe apilar dos diálogos.
        procesando = true;
        try
        {
            await UiAcciones.ConfirmarEliminarYRecargarAsync(DialogService, Notifications,
                $"¿Eliminar el usuario «{u.Nombre}» ({u.WindowsUser})? Si trabajó en el sistema conviene desactivarlo en vez de borrarlo.",
                () => Service.EliminarAsync(u.Id, u.RowVersion),
                "Usuario eliminado", u.Nombre ?? "",
                "Ya eliminado", $"El usuario «{u.Nombre}» ya había sido eliminado por otro administrador.",
                CargarAsync);
        }
        finally { procesando = false; }
    }
}
