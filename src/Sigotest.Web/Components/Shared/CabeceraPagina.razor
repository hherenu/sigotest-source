@* Cabecera estándar de todas las páginas (salvo el Home y SinAcceso): título H1 (+badges) y subtítulo
   a la izquierda, botones de acción a la derecha. Antes estaba copiada con variaciones
   accidentales en 9 páginas; las diferencias deliberadas entran por parámetros. *@
@if (Migas is { Count: > 0 })
{
    @* Miga de pan para las páginas anidadas bajo obra (la app no tenía ninguna
       indicación de ubicación en jerarquías de 3-4 niveles). El último tramo es la
       página actual y va sin link. *@
    <nav aria-label="Ubicación" class="app-migas">
        @for (var i = 0; i < Migas.Count; i++)
        {
            var miga = Migas[i];
            if (i > 0)
            {
                <span aria-hidden="true">/</span>
            }
            @if (miga.Ruta is not null)
            {
                <RadzenLink Path="@miga.Ruta" Text="@miga.Texto" />
            }
            else
            {
                <span aria-current="page">@miga.Texto</span>
            }
        }
    </nav>
}
<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
             AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Gap="0.5rem" class="@Clase">
    <RadzenStack Gap="0.25rem">
        @if (Badges is null)
        {
            <RadzenText TextStyle="@Estilo" TagName="TagName.H1" class="rz-mb-0">@Titulo</RadzenText>
        }
        else
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenText TextStyle="@Estilo" TagName="TagName.H1" class="rz-mb-0">@Titulo</RadzenText>
                @Badges
            </RadzenStack>
        }
        @if (Subtitulo is not null)
        {
            <RadzenText TextStyle="TextStyle.Caption" class="app-muted rz-mb-0">@Subtitulo</RadzenText>
        }
        @SubtituloExtra
    </RadzenStack>
    @if (Acciones is not null)
    {
        @* Botones Small (convenciones-ui) y, con app-cabecera-acciones, buscadores y
           selectores de la misma altura que ellos. *@
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap"
                     class="app-cabecera-acciones">
            @Acciones
        </RadzenStack>
    }
</RadzenStack>

@code {
    /// <summary>Título de la página (H1 visual en el TextStyle de <see cref="Estilo"/>).</summary>
    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;

    /// <summary>
    /// TextStyle del título: H4 solo en las páginas raíz del menú (Obras, Índices INDEC,
    /// Calcular, Historial, Planificación, Usuarios); el resto, H5 (ConvencionesUiTests).
    /// </summary>
    [Parameter] public TextStyle Estilo { get; set; } = TextStyle.H5;

    /// <summary>Badges a la derecha del título (estado, fechas).</summary>
    [Parameter] public RenderFragment? Badges { get; set; }

    /// <summary>Subtítulo en el caption estándar (obra — licitación). Admite contenido con estilo.</summary>
    [Parameter] public RenderFragment? Subtitulo { get; set; }

    /// <summary>Contenido libre debajo del título, fuera del caption (ej. badges del índice).</summary>
    [Parameter] public RenderFragment? SubtituloExtra { get; set; }

    /// <summary>Botones de la derecha.</summary>
    [Parameter] public RenderFragment? Acciones { get; set; }

    /// <summary>
    /// Clases del contenedor. El margen inferior es 1rem en todas las páginas (antes la
    /// mitad pasaba rz-mb-4 y la otra mitad quedaba en rz-mb-3).
    /// </summary>
    [Parameter] public string Clase { get; set; } = "rz-mb-4";

    /// <summary>Tramo de la miga de pan: texto + ruta (null = página actual, sin link).</summary>
    public record Miga(string Texto, string? Ruta = null);

    /// <summary>Miga de pan sobre el título (páginas anidadas bajo obra). Null = sin miga.</summary>
    [Parameter] public IReadOnlyList<Miga>? Migas { get; set; }
}
