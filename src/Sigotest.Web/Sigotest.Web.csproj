<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- El csproj se llama Sigotest.Web porque el workflow del repo hardcodea esa ruta;
         el ensamblado y los namespaces siguen siendo SIGO (el código no se renombró). -->
    <AssemblyName>SIGO</AssemblyName>
    <RootNamespace>SIGO</RootNamespace>
  </PropertyGroup>

  <!-- Contrato del sitio: la config de desarrollo nunca viaja en el artifact publicado. -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <!-- Lectura de planillas subidas (.xls, .xlsx y .xlsm): ClosedXML solo lee .xlsx y
         las planillas reales de las contratistas llegan en los tres formatos. -->
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Radzen.Blazor" Version="10.4.3" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.14" />
    <!-- Fija la dependencia transitiva: EF Core SqlServer 10.0.14 → Microsoft.Data.SqlClient 6.1.7
         la trae como 9.0.11, con vulnerabilidades conocidas (NU1902/NU1903). Revisar si sigue
         haciendo falta cada vez que se actualice EF Core: sacarlo y listar los paquetes
         vulnerables incluyendo los transitivos (dotnet list package). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
